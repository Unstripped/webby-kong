    "nipplejs": "1.0.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/preact": "3.2.6",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
