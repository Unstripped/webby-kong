# webby-kong settings: copy to .env (gitignored) and edit. Both ways to run the server read this one file:
#
#   mise run serve                                            # local, from this checkout
#   docker run --env-file .env ... ghcr.io/unstripped/webby-kong
#
# The values below are the defaults; command-line flags (--dir --port --bind --db --rom) override the variables.
# The path variables stay unset on purpose: locally they default to build/web and ~/.local/share/webby-kong, while
# the image sets WEBBY_KONG_DIR=/srv/web, WEBBY_KONG_BIND=0.0.0.0, WEBBY_KONG_DB=/data/saves.sqlite3 and
# WEBBY_KONG_ROM=/rom, so --env-file does not overwrite them.

# --- the server (tools/serve.py) ---
# directory to serve
#WEBBY_KONG_DIR=build/web
# address to listen on (:: = all interfaces, IPv4 and IPv6)
#WEBBY_KONG_BIND=::
WEBBY_KONG_PORT=8080
# SQLite file: saves, and with sign-in on users, passkeys, sessions and invites
#WEBBY_KONG_DB=~/.local/share/webby-kong/saves.sqlite3
# ROM file, or a directory holding one *.z64/*.n64/*.v64, served at /api/rom (unset: the page asks for the ROM)
#WEBBY_KONG_ROM=

# --- optional passkey sign-in (WEBBY_KONG_AUTH=1) ---
WEBBY_KONG_AUTH=0
# the URL people actually open: WebAuthn origin, RP ID host and base of invite links (https, or http://localhost)
WEBBY_KONG_EXTERNAL_URL=http://localhost:8080
# name shown in the passkey prompt
WEBBY_KONG_RP_NAME=Webby
# session cookie lifetime in days
WEBBY_KONG_SESSION_DAYS=30
# seed of the owner's registration toggle (the database wins afterwards)
WEBBY_KONG_REGISTRATION_OPEN=1

# invite email (without a host the dashboard offers the link to copy instead)
WEBBY_KONG_SMTP_HOST=
WEBBY_KONG_SMTP_PORT=587
WEBBY_KONG_SMTP_USERNAME=
WEBBY_KONG_SMTP_PASSWORD=
# envelope sender (default: WEBBY_KONG_SMTP_USERNAME)
WEBBY_KONG_SMTP_FROM=
# starttls | ssl | none
WEBBY_KONG_SMTP_TLS=starttls
# SMTP socket timeout in seconds
WEBBY_KONG_SMTP_TIMEOUT=10
