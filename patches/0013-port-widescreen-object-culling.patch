From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Wed, 18 Nov 2026 10:10:21 -0700
Subject: [PATCH] port: widescreen object culling


diff --git a/src/global/55B20_map_chunk.c b/src/global/55B20_map_chunk.c
index afa1aee..340583b 100644
--- a/src/global/55B20_map_chunk.c
+++ b/src/global/55B20_map_chunk.c
@@ -1168,12 +1168,60 @@ u8 mapNodeTriangleContainsPoint(MapCollisionNode *tri, f32 x, f32 z) {
 extern PlayerStruct *gPlayerSlots;
 extern u8 gCurrentPlayerIndex;
 
+/* PORT: Hor+ widescreen shows the scene across portGfxWideSpanX(), which reaches past the viewport rect on both sides
+ * by the side areas plus the overscan border the game leaves around the rect. Portal screen rects run in the game's
+ * screen coordinates, so let them reach this many pixels past each side of the rect (exact, for the frustum
+ * mapping; rounded up, for rect bounds). */
+static f32 mapWideExtraF(u8 player) {
+    f32 left;
+    f32 right;
+    f32 extra;
+
+    if (!portGfxWideSpanX(&left, &right)) {
+        return 0.0f;
+    }
+    extra = gPlayerSlots[player].rect[0] - left;
+    if (right - gPlayerSlots[player].rect[2] > extra) {
+        extra = right - gPlayerSlots[player].rect[2];
+    }
+    return extra > 0.0f ? extra : 0.0f;
+}
+
+/* PORT: the frustum corner rays' widening, so they span rect[0] - extra .. rect[2] + extra (frustumCalculateCornerRays) */
+f32 mapWideFactor(void) {
+    f32 w = gPlayerSlots[gCurrentPlayerIndex].rectWidth;
+
+    return w > 0.0f ? (w + 2.0f * mapWideExtraF(gCurrentPlayerIndex)) / w : 1.0f;
+}
+
+static s32 mapWideExtra(void) {
+    f32 extraF = mapWideExtraF(gCurrentPlayerIndex);
+    s32 extra = extraF > 0.0f ? (s32)extraF + 1 : 0;
+
+    if (gPlayerSlots[gCurrentPlayerIndex].rect[0] - extra == -1) {
+        extra++; // -1 is the portal code's "not visible" sentinel
+    }
+    return extra;
+}
+
+/* PORT: a scissor can't hold the widened rect's negative x; clamp to the viewport, whose edges the renderer
+ * extends into the side areas */
+s32 mapScissorX(s32 x) {
+    if (x < gPlayerSlots[gCurrentPlayerIndex].rect[0]) {
+        return gPlayerSlots[gCurrentPlayerIndex].rect[0];
+    }
+    if (x > gPlayerSlots[gCurrentPlayerIndex].rect[2]) {
+        return gPlayerSlots[gCurrentPlayerIndex].rect[2];
+    }
+    return x;
+}
+
 void mapChunkActivate(s16 chunkIndex) {
     gMapChunks[chunkIndex].state = 1;
     gMapChunks[chunkIndex].playerMask |= 1 << gCurrentPlayerIndex;
-    gMapChunks[chunkIndex].clipLeft = gPlayerSlots[gCurrentPlayerIndex].rect[0];
+    gMapChunks[chunkIndex].clipLeft = gPlayerSlots[gCurrentPlayerIndex].rect[0] - mapWideExtra(); // PORT: wide side areas
     gMapChunks[chunkIndex].clipTop = gPlayerSlots[gCurrentPlayerIndex].rect[1];
-    gMapChunks[chunkIndex].clipRight = gPlayerSlots[gCurrentPlayerIndex].rect[2];
+    gMapChunks[chunkIndex].clipRight = gPlayerSlots[gCurrentPlayerIndex].rect[2] + mapWideExtra();
     gMapChunks[chunkIndex].clipBottom = gPlayerSlots[gCurrentPlayerIndex].rect[3];
 }
 
@@ -1203,7 +1251,7 @@ void mapChunkFrameUpdate(f32 x, f32 y, f32 z) {
     mapTriggerCollectZonesAtPoint(x, y, z);
     sMapVisibleChunkCount = 0;
     sMapVisiblePortalCount = 0;
-    mapChunkTraversePortals(gPlayerSlots[gCurrentPlayerIndex].camChunk, 0, gPlayerSlots[gCurrentPlayerIndex].rect[0], gPlayerSlots[gCurrentPlayerIndex].rect[1], gPlayerSlots[gCurrentPlayerIndex].rect[2], gPlayerSlots[gCurrentPlayerIndex].rect[3], x, y, z);
+    mapChunkTraversePortals(gPlayerSlots[gCurrentPlayerIndex].camChunk, 0, gPlayerSlots[gCurrentPlayerIndex].rect[0] - mapWideExtra(), gPlayerSlots[gCurrentPlayerIndex].rect[1], gPlayerSlots[gCurrentPlayerIndex].rect[2] + mapWideExtra(), gPlayerSlots[gCurrentPlayerIndex].rect[3], x, y, z); // PORT: wide side areas
     mapChunkRenderNodes(x, y, z);
     effectWaterUpdateMeshes(x, y, z, gCurrentPlayerIndex);
     actorCalculateTargetDistancesAndAngles(x, y, z);
@@ -1394,10 +1442,12 @@ void mapScreenRectBuildFrustum(s32 left, s32 top, s32 right, s32 bottom, f32 x,
     f32 y0;
     f32 y1;
     f32 m[4][3];
+    f32 wideExtra;
 
-    q = ((f32)(left - gPlayerSlots[player].rect[0])) / (f32)gPlayerSlots[player].rectWidth;
+    wideExtra = mapWideExtraF(player); // PORT: the corner rays span the wide image, rect[0] - wideExtra .. rect[2] + wideExtra
+    q = ((f32)(left - gPlayerSlots[player].rect[0]) + wideExtra) / ((f32)gPlayerSlots[player].rectWidth + 2.0f * wideExtra);
     x0 = (q * (sFrustumCornerRays.c1x - sFrustumCornerRays.c0x)) + sFrustumCornerRays.c0x;
-    q = ((f32)(right - gPlayerSlots[player].rect[0])) / (f32)gPlayerSlots[player].rectWidth;
+    q = ((f32)(right - gPlayerSlots[player].rect[0]) + wideExtra) / ((f32)gPlayerSlots[player].rectWidth + 2.0f * wideExtra);
     x1 = (q * (sFrustumCornerRays.c1x - sFrustumCornerRays.c0x)) + sFrustumCornerRays.c0x;
     q = ((f32)(top - gPlayerSlots[player].rect[1])) / (f32)gPlayerSlots[player].rectHeight;
     y0 = ((sFrustumCornerRays.c2y - sFrustumCornerRays.c0y) * q) + sFrustumCornerRays.c0y;
@@ -1863,7 +1913,7 @@ Gfx *mapChunksRender(Gfx *gfx, MapBspNode *view, f32 x, f32 y, f32 z, s32 flags)
                 gMapChunks[idx].texAnimPending = 0;
             }
             gDPPipeSync(gfx++);
-            gDPSetScissor(gfx++, G_SC_NON_INTERLACE, gMapChunks[idx].clipLeft, gMapChunks[idx].clipTop, gMapChunks[idx].clipRight, gMapChunks[idx].clipBottom);
+            gDPSetScissor(gfx++, G_SC_NON_INTERLACE, mapScissorX(gMapChunks[idx].clipLeft), gMapChunks[idx].clipTop, mapScissorX(gMapChunks[idx].clipRight), gMapChunks[idx].clipBottom); // PORT: widened rect
             mapSetClipBounds(gMapChunks[idx].clipLeft, gMapChunks[idx].clipTop, gMapChunks[idx].clipRight, gMapChunks[idx].clipBottom);
             gfx = fogRender(gfx);
             if (flags & 0x10) {
@@ -1939,7 +1989,7 @@ Gfx *mapChunksRender(Gfx *gfx, MapBspNode *view, f32 x, f32 y, f32 z, s32 flags)
         idx = sMapVisibleChunks[i];
         if (gMapChunks[idx].state == 1) {
             gDPPipeSync(gfx++);
-            gDPSetScissor(gfx++, G_SC_NON_INTERLACE, gMapChunks[idx].clipLeft, gMapChunks[idx].clipTop, gMapChunks[idx].clipRight, gMapChunks[idx].clipBottom);
+            gDPSetScissor(gfx++, G_SC_NON_INTERLACE, mapScissorX(gMapChunks[idx].clipLeft), gMapChunks[idx].clipTop, mapScissorX(gMapChunks[idx].clipRight), gMapChunks[idx].clipBottom); // PORT: widened rect
             mapSetClipBounds(gMapChunks[idx].clipLeft, gMapChunks[idx].clipTop, gMapChunks[idx].clipRight, gMapChunks[idx].clipBottom);
             gRenderSetupKind = 0xFF;
             if (flag) {
@@ -2469,22 +2519,24 @@ void mapPolyProjectToScreenRect(s32 count, s32 *outLeft, s32 *outTop, s32 *outRi
     s16 y;
     s32 i;
     u8 flag;
+    s32 wideLeft = gPlayerSlots[gCurrentPlayerIndex].rect[0] - mapWideExtra(); // PORT: portals in the wide side areas
+    s32 wideRight = gPlayerSlots[gCurrentPlayerIndex].rect[2] + mapWideExtra();
 
-    *outLeft = gPlayerSlots[gCurrentPlayerIndex].rect[2];
+    *outLeft = wideRight;
     *outTop = gPlayerSlots[gCurrentPlayerIndex].rect[3];
-    *outRight = gPlayerSlots[gCurrentPlayerIndex].rect[0];
+    *outRight = wideLeft;
     *outBottom = gPlayerSlots[gCurrentPlayerIndex].rect[1];
     flag = 0;
     for (i = 0; i < count; i++) {
         flag |= camProjectToScreen(sMapClippedPoly[i].x, sMapClippedPoly[i].y, sMapClippedPoly[i].z, &sx, &sy, 0, 1.0f, gCurrentPlayerIndex); x = (s16)sx; y = (s16)sy; // LAYOUT: same-line statements steer sra scheduling
-        if (x < gPlayerSlots[gCurrentPlayerIndex].rect[0]) {
-            x = gPlayerSlots[gCurrentPlayerIndex].rect[0];
+        if (x < wideLeft) {
+            x = wideLeft;
         }
         if (y < gPlayerSlots[gCurrentPlayerIndex].rect[1]) {
             y = gPlayerSlots[gCurrentPlayerIndex].rect[1];
         }
-        if (gPlayerSlots[gCurrentPlayerIndex].rect[2] < x) {
-            x = gPlayerSlots[gCurrentPlayerIndex].rect[2];
+        if (wideRight < x) {
+            x = wideRight;
         }
         if (gPlayerSlots[gCurrentPlayerIndex].rect[3] < y) {
             y = gPlayerSlots[gCurrentPlayerIndex].rect[3];
@@ -2507,6 +2559,8 @@ void mapPolyProjectToScreenRect(s32 count, s32 *outLeft, s32 *outTop, s32 *outRi
         *outTop = -1;
         *outRight = -1;
         *outBottom = -1;
+    } else if (*outLeft == -1) {
+        *outLeft = -2; // PORT: -1 is the "not visible" sentinel; a widened rect can reach it legitimately
     }
 }
 
@@ -2676,6 +2730,7 @@ u8 mapSearchTableGetValue(void *key) {
 
 
 void mapSetClipBounds(s16 left, s16 top, s16 right, s16 bottom) {
+    portGfxWideClipX(&left, &right); // PORT: Hor+ shows more at the sides; don't cull objects there
     sMapClipLeft = left;
     sMapClipTop = top;
     sMapClipRight = right;
diff --git a/src/global/63EC0_effect_water.c b/src/global/63EC0_effect_water.c
index 5e71ca3..57b5b29 100644
--- a/src/global/63EC0_effect_water.c
+++ b/src/global/63EC0_effect_water.c
@@ -364,15 +364,17 @@ Gfx *effectWaterRenderSurfaces(Gfx *gdl, s32 viewMode, u8 waterType) {
     return gdl;
 }
 
+s32 mapScissorX(s32 x); // PORT: 55B20.c, clamps widened chunk rects for the scissor
+
 Gfx *effectWaterSetScissor(Gfx *gdl, WaterSurface *water) {
     s32 index;
 
     gDPPipeSync(gdl++);
     if (water->sub->chunkCount == 1) {
         index = water->sub->chunkIds[0];
-        gDPSetScissor(gdl++, G_SC_NON_INTERLACE, gMapChunks[index].clipLeft, gMapChunks[index].clipTop, gMapChunks[index].clipRight, gMapChunks[index].clipBottom);
+        gDPSetScissor(gdl++, G_SC_NON_INTERLACE, mapScissorX(gMapChunks[index].clipLeft), gMapChunks[index].clipTop, mapScissorX(gMapChunks[index].clipRight), gMapChunks[index].clipBottom);
     } else {
-        gDPSetScissor(gdl++, G_SC_NON_INTERLACE, water->scissorLeft, water->scissorTop, water->scissorRight, water->scissorBottom);
+        gDPSetScissor(gdl++, G_SC_NON_INTERLACE, mapScissorX(water->scissorLeft), water->scissorTop, mapScissorX(water->scissorRight), water->scissorBottom);
     }
     return gdl;
 }
