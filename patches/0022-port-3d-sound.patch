 }
 
+// PORT: 3D sound: a looping positional sound's direction, updated every frame by the sfx code (7130.c).
+// Like the player's events (__n_handleEvent), it covers the handle's layered states: next states up to the
+// next group head (flags & 1).
+void n_alSndpSetSpatial(GfSndState *state, u32 dir) {
+    if (state) {
+        portSpatialBind(&state->voice, dir);
+        for (state = state->next; state != NULL && !(state->flags & 1); state = state->next) {
+            portSpatialBind(&state->voice, dir);
+        }
+    }
+}
+
 GfSndState *n_alSndpPlay(void *bank, s16 sndId, u16 vol, u8 pan, f32 pitch, u8 fxMix, GfSndState **handle) {
     GfSndState *state;
     GfSndState *ret;
@@ -529,15 +543,18 @@ GfSndState *n_alSndpPlay(void *bank, s16 sndId, u16 vol, u8 pan, f32 pitch, u8 f
     s32 val;
     GeSndEvt ev1;
     GeSndEvt ev2;
+    u32 spatial; // PORT: 3D sound
 
     ret = NULL;
     lastId = 0;
     total = 0;
+    spatial = portSpatialTakePending();
     if (sndId) {
         do {
             sound = ((ALBank *)bank)->instArray[0]->soundArray[sndId - 1];
             state = __n_allocState(bank, sound);
             if (state) {
+                portSpatialBind(&state->voice, spatial);
                 gSndp->target = state;
                 ev1.type = 1;
                 ev1.state = state;
