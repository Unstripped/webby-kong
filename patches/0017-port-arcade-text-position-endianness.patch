From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Thu, 19 Nov 2026 12:35:18 -0700
Subject: [PATCH] port: arcade text position endianness


diff --git a/src/arcade/0_game.c b/src/arcade/0_game.c
index 5543921..8a35785 100644
--- a/src/arcade/0_game.c
+++ b/src/arcade/0_game.c
@@ -146,7 +146,9 @@ void arcadeDrawString(Gfx **glistp, u8 *str) {
     gDPSetPrimColor(g++, 0, 0, gArcadeTextColorR, gArcadeTextColorG, gArcadeTextColorB, gArcadeTextColorA);
     gDPSetCombine(g++, 0x119623, 0xFF2FFFFF);
     gSPSetOtherMode(g++, G_SETOTHERMODE_L, G_MDSFT_RENDERMODE, 29, 0x00504240);
-    *glistp = textDrawString(g, 2, gArcadeTextX, gArcadeTextY, str);
+    /* PORT: the N64 read the low halves of the s32 position at +2 (gArcadeTextX, gArcadeTextY); on little-endian
+     * wasm those are the high halves (0), stacking every string at the top-left corner */
+    *glistp = textDrawString(g, 2, (s16)gArcadeTextX, (s16)gArcadeTextY, str);
 }
 
 extern u32 gArcadeRandSeed;
