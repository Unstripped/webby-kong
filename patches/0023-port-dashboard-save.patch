Subject: [PATCH] port: dashboard save


diff --git a/src/global/104F0_eeprom.c b/src/global/104F0_eeprom.c
index 3435f73..27eb77f 100644
--- a/src/global/104F0_eeprom.c
+++ b/src/global/104F0_eeprom.c
@@ -118,7 +118,10 @@ void eepromDispatchCommand(s32 cmd) {
         return;
     }
     if (gMainThreadHalted == 0) {
-        osSendMesg(&gEepromCmdQueue, (void *)cmd, 0);
+        gPortEepromQueued++; /* port dashboard exit: web/menu.js waits until the EEPROM thread is idle */
+        if (osSendMesg(&gEepromCmdQueue, (void *)cmd, 0) != 0) {
+            gPortEepromQueued--;
+        }
     }
 }
 
@@ -891,6 +894,7 @@ void eepromThreadMain(void *arg) {
     while (TRUE) {
         osRecvMesg(&gEepromCmdQueue, &msg, 1);
         sEepromCommandHandlers[(s32)msg]();
+        gPortEepromQueued--;
     }
 }
 
diff --git a/src/global/3C10_map_transition.c b/src/global/3C10_map_transition.c
index 0154d10..b1dedd0 100644
--- a/src/global/3C10_map_transition.c
+++ b/src/global/3C10_map_transition.c
@@ -748,6 +748,39 @@ s32 mapCaptureLevelProgress(PortLevelProgress *out, const char **reason) {
     return 1;
 }
 
+extern s8 sPauseKongUnlocked[5]; /* ACDC0.c */
+s32 menuCalculateGamePercentage(void); /* src/menu/3E10.c */
+s32 playTimeGetSeconds(void); /* src/global/450.c */
+
+/* PORT: the save's headline numbers for the dashboard (port/src/progress.c), counted like the file select
+ * (menuInitFileSummary) and the pause menu totals, from the live state of the file being played. */
+s32 mapCaptureSaveSummary(PortSaveSummary *out, const char **reason) {
+    s32 k;
+
+    if (gMenuCurrentMode != 6) {
+        *reason = "not in adventure mode";
+        return 0;
+    }
+    if (gPlayerCount >= 2 || menuIsTransitionType3Or4()) {
+        *reason = "multiplayer";
+        return 0;
+    }
+    out->slot = gEepromCurrentSlot;
+    out->percent = menuCalculateGamePercentage(); /* refreshes gPauseCollectibleCounts and sPauseKongUnlocked */
+    out->goldenBananas = gPauseCollectibleCounts[0];
+    out->crowns = gPauseCollectibleCounts[1];
+    out->keys = gPauseCollectibleCounts[2];
+    out->medals = gPauseCollectibleCounts[3];
+    out->fairies = gPauseCollectibleCounts[5];
+    out->blueprints = gPauseCollectibleCounts[7];
+    out->kongs = 0;
+    for (k = 0; k < 5; k++) {
+        out->kongs += sPauseKongUnlocked[k] != 0;
+    }
+    out->playSeconds = playTimeGetSeconds();
+    return 1;
+}
+
 void mapTransitionToPreviousOrExit(void) {
     s32 targetMap;
     s32 exitIndex;
