From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:10:45 -0700
Subject: [PATCH] port: framebuffer coherence


diff --git a/src/global/103AB0.c b/src/global/103AB0.c
index 8f3519d..e09f059 100644
--- a/src/global/103AB0.c
+++ b/src/global/103AB0.c
@@ -198,7 +198,7 @@ u16 *sepiaCopyFramebufferTile(u16 *dst, u16 *src) {
 
     for (i = 0; i < 0x40; i++) {
         for (j = 0; j < 0x20; j++) {
-            *dst++ = color5551ToSepia(src[j + i * gScreenWidth]);
+            *dst++ = PORT_BE16(color5551ToSepia(PORT_BE16(src[j + i * gScreenWidth])));
         }
     }
     return dst;
@@ -224,6 +224,7 @@ u16 *playerViewCaptureSepiaPhoto(void) {
     }
     buf = heapAlloc(0xA000);
     dst = buf;
+    portGfxSyncRdram(gFramebuffers[gGfxBufferIndex], gScreenWidth * gScreenHeight * 2);
     src = (u16 *)gFramebuffers[gGfxBufferIndex] + gScreenWidth * 56 + 80;
     row = 0;
     do {
@@ -254,7 +255,7 @@ void color5551CopyLerpToWhite(u16 *src, s16 **outBuf, f32 t) {
     heapFreeDeferred(*outBuf);
     dst = *outBuf;
     for (i = 0; i < 0x5000; i++) {
-        *dst++ = color5551LerpToWhite(t, *src++);
+        *dst++ = PORT_BE16(color5551LerpToWhite(t, PORT_BE16(*src++)));
     }
 }
 
@@ -407,6 +408,7 @@ u16 zbufferReadDepth(s16 x, s16 y) {
         return 0xFFFF;
     }
     depth += gScreenWidth * y + x;
+    portGfxSyncRdram(gGfxDepthBuffer, gScreenWidth * gScreenHeight * 2);
     z = *depth;
     entry = tablePtr->words + (((z >> 13) & 0xFFFF & 0xFFFF & 0xFFFF & 0xFFFF & 0xFFFF & 0xFFFF & 0xFFFF & 7) * 2); // FAKE: no-op masks advance the ugen temp ring (Q0374)
     mantissa = z >> 2;
diff --git a/src/global/10E1D0.c b/src/global/10E1D0.c
index 5436f85..b2c7cac 100644
--- a/src/global/10E1D0.c
+++ b/src/global/10E1D0.c
@@ -368,18 +368,20 @@ void fbCopySetAlpha(void *dstBuf, void *srcBuf) {
     s32 *src = srcBuf;
     s32 *dst = dstBuf;
 
+    portGfxSyncRdram(srcBuf, gScreenWidth * gScreenHeight * 2);
     for (i = 0; i < (gScreenWidth * gScreenHeight) / 16; i++) {
-        dst[0] = src[0] | 0x10001;
-        dst[1] = src[1] | 0x10001;
-        dst[2] = src[2] | 0x10001;
-        dst[3] = src[3] | 0x10001;
-        dst[4] = src[4] | 0x10001;
-        dst[5] = src[5] | 0x10001;
-        dst[6] = src[6] | 0x10001;
-        dst[7] = src[7] | 0x10001;
+        dst[0] = src[0] | PORT_BE32(0x10001);
+        dst[1] = src[1] | PORT_BE32(0x10001);
+        dst[2] = src[2] | PORT_BE32(0x10001);
+        dst[3] = src[3] | PORT_BE32(0x10001);
+        dst[4] = src[4] | PORT_BE32(0x10001);
+        dst[5] = src[5] | PORT_BE32(0x10001);
+        dst[6] = src[6] | PORT_BE32(0x10001);
+        dst[7] = src[7] | PORT_BE32(0x10001);
         dst += 8;
         src += 8;
     }
+    portGfxCpuWrote(dstBuf, gScreenWidth * gScreenHeight * 2);
 }
 
 
@@ -531,24 +533,26 @@ void transitionMaskFramebuffer(u16 *framebuffer) {
     s32 t = gTransitionProgress - 5;
     s32 count = (t * 0xF0) / 0x50;
 
+    portGfxSyncRdram(framebuffer, 0x140 * 0xF0 * 2);
     for (i = 0; i < count; i++) {
-        pixels[0] = pixels[0] & mask.data[(i & 3) * 6];
-        pixels[1] = pixels[1] & mask.data[(i & 3) * 6 + 1];
-        pixels[2] = pixels[2] & mask.data[(i & 3) * 6 + 2];
-        pixels[3] = pixels[3] & mask.data[(i & 3) * 6 + 3];
-        pixels[4] = pixels[4] & mask.data[(i & 3) * 6 + 4];
-        pixels[5] = pixels[5] & mask.data[(i & 3) * 6 + 5];
+        pixels[0] = pixels[0] & PORT_BE16(mask.data[(i & 3) * 6]);
+        pixels[1] = pixels[1] & PORT_BE16(mask.data[(i & 3) * 6 + 1]);
+        pixels[2] = pixels[2] & PORT_BE16(mask.data[(i & 3) * 6 + 2]);
+        pixels[3] = pixels[3] & PORT_BE16(mask.data[(i & 3) * 6 + 3]);
+        pixels[4] = pixels[4] & PORT_BE16(mask.data[(i & 3) * 6 + 4]);
+        pixels[5] = pixels[5] & PORT_BE16(mask.data[(i & 3) * 6 + 5]);
         pixels += 0x140;
     }
     for (i = count; i < 0xF0; i++) {
-        pixels[0] |= 1;
-        pixels[1] |= 1;
-        pixels[2] |= 1;
-        pixels[3] |= 1;
-        pixels[4] |= 1;
-        pixels[5] |= 1;
+        pixels[0] |= PORT_BE16(1);
+        pixels[1] |= PORT_BE16(1);
+        pixels[2] |= PORT_BE16(1);
+        pixels[3] |= PORT_BE16(1);
+        pixels[4] |= PORT_BE16(1);
+        pixels[5] |= PORT_BE16(1);
         pixels += 0x140;
     }
+    portGfxCpuWrote(framebuffer, 0x140 * 0xF0 * 2);
 }
 
 extern u8 sTransitionState;
diff --git a/src/global/15050.c b/src/global/15050.c
index ee98754..062385c 100644
--- a/src/global/15050.c
+++ b/src/global/15050.c
@@ -221,9 +221,10 @@ void loadOverlay(u8 keepSurvivors, u8 overlayId, s32 bufferSize) {
         q = (u8 *)gFramebuffers[id];
         p = (u32 *)(q + (gHiResScale * 0x12C00 * gHiResScale) / 2 * 4);
         while (q < (u8 *)p) {
-            *(u32 *)q = 0x10001;
+            *(u32 *)q = PORT_BE32(0x10001);
             q += 4;
         }
+        portGfxCpuWrote(gFramebuffers[id], (gHiResScale * 0x12C00 * gHiResScale) / 2 * 4);
     }
 }
 
diff --git a/src/global/2DE90.c b/src/global/2DE90.c
index cd7291d..b986ae9 100644
--- a/src/global/2DE90.c
+++ b/src/global/2DE90.c
@@ -320,7 +320,7 @@ void screenBlurApply(void) {
             }
             idx = D_80747B28 / 2;
             for (i = 0; i < D_80747B28 / 2; i++) {
-                pix = *src;
+                pix = PORT_BE16(*src);
                 vr = (pix >> 11) & 0x1F;
                 r[idx] = vr;
                 sumR += vr;
@@ -335,7 +335,7 @@ void screenBlurApply(void) {
             }
             idx = 0;
             for (i = 0; i < D_80747B30 - D_80747B28 / 2; i++) {
-                pix = *src++;
+                pix = PORT_BE16(*src++);
                 if (idx >= D_80747B28) {
                     idx = 0;
                 }
@@ -352,7 +352,7 @@ void screenBlurApply(void) {
                 b[idx] = vb;
                 idx++;
                 sumB += vb;
-                *dst = 1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11);
+                *dst = PORT_BE16(1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11));
                 dst++;
             }
             for (i = D_80747B30 - D_80747B28 / 2; i < D_80747B30; i++) {
@@ -366,7 +366,7 @@ void screenBlurApply(void) {
                 g[idx] = 0;
                 b[idx] = 0;
                 idx++;
-                *dst = 1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11);
+                *dst = PORT_BE16(1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11));
                 dst++;
             }
         }
diff --git a/src/global/450.c b/src/global/450.c
index e918686..203d0fd 100644
--- a/src/global/450.c
+++ b/src/global/450.c
@@ -269,7 +269,7 @@ void viModeApplyHighRes(void) {
     fb = gFramebuffers[0];
     end = (u16 *)((u8 *)fb + 0x25800);
     while (fb < end) {
-        *fb++ = 1;
+        *fb++ = PORT_BE16(1);
     }
     osWritebackDCacheAll();
 
@@ -304,9 +304,11 @@ void viModeApplyHighRes(void) {
     fb = gFramebuffers[1];
     end = (u16 *)((u8 *)fb + 0x25800);
     while (fb < end) {
-        *fb++ = 1;
+        *fb++ = PORT_BE16(1);
     }
     osWritebackDCacheAll();
+    portGfxCpuWrote(gFramebuffers[0], 0x25800);
+    portGfxCpuWrote(gFramebuffers[1], 0x25800);
 }
 
 
