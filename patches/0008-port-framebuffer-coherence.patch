From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:10:45 -0700
Subject: [PATCH] port: framebuffer coherence


diff --git a/src/global/103AB0.c b/src/global/103AB0.c
index 7cda21d..9d051aa 100644
--- a/src/global/103AB0.c
+++ b/src/global/103AB0.c
@@ -276,7 +276,7 @@ u16 *sepiaCopyFramebufferTile(u16 *dst, u16 *src) {
 
     for (i = 0; i < 0x40; i++) {
         for (j = 0; j < 0x20; j++) {
-            *dst++ = color5551ToSepia(src[j + i * gScreenWidth]);
+            *dst++ = PORT_BE16(color5551ToSepia(PORT_BE16(src[j + i * gScreenWidth])));
         }
     }
     return dst;
@@ -302,6 +302,7 @@ u16 *playerViewCaptureSepiaPhoto(void) {
     }
     buf = heapAlloc(0xA000);
     dst = buf;
+    portGfxSyncRdram(gFramebuffers[gGfxBufferIndex], gScreenWidth * gScreenHeight * 2);
     src = (u16 *)gFramebuffers[gGfxBufferIndex] + gScreenWidth * 56 + 80;
     row = 0;
     do {
@@ -332,7 +333,7 @@ void color5551CopyLerpToWhite(u16 *src, s16 **outBuf, f32 t) {
     heapFreeDeferred(*outBuf);
     dst = *outBuf;
     for (i = 0; i < 0x5000; i++) {
-        *dst++ = color5551LerpToWhite(t, *src++);
+        *dst++ = PORT_BE16(color5551LerpToWhite(t, PORT_BE16(*src++)));
     }
 }
 
@@ -478,6 +479,7 @@ u16 zbufferReadDepth(s16 x, s16 y) {
         return 0xFFFF;
     }
     depth += gScreenWidth * y + x;
+    portGfxSyncRdram(gGfxDepthBuffer, gScreenWidth * gScreenHeight * 2);
     z = *depth;
     exponent = (z >> 13) & 7;
     mantissa = (z >> 2) & 0x7FF;
diff --git a/src/global/10E1D0.c b/src/global/10E1D0.c
index 3cdd24f..3dae101 100644
--- a/src/global/10E1D0.c
+++ b/src/global/10E1D0.c
@@ -362,18 +362,20 @@ void fbCopySetAlpha(void *dstBuf, void *srcBuf) {
     s32 *src = srcBuf;
     s32 *dst = dstBuf;
 
+    portGfxSyncRdram(srcBuf, gScreenWidth * gScreenHeight * 2);
     for (i = 0; i < (gScreenWidth * gScreenHeight) / 16; i++) {
-        dst[0] = src[0] | 0x10001;
-        dst[1] = src[1] | 0x10001;
-        dst[2] = src[2] | 0x10001;
-        dst[3] = src[3] | 0x10001;
-        dst[4] = src[4] | 0x10001;
-        dst[5] = src[5] | 0x10001;
-        dst[6] = src[6] | 0x10001;
-        dst[7] = src[7] | 0x10001;
+        dst[0] = src[0] | PORT_BE32(0x10001);
+        dst[1] = src[1] | PORT_BE32(0x10001);
+        dst[2] = src[2] | PORT_BE32(0x10001);
+        dst[3] = src[3] | PORT_BE32(0x10001);
+        dst[4] = src[4] | PORT_BE32(0x10001);
+        dst[5] = src[5] | PORT_BE32(0x10001);
+        dst[6] = src[6] | PORT_BE32(0x10001);
+        dst[7] = src[7] | PORT_BE32(0x10001);
         dst += 8;
         src += 8;
     }
+    portGfxCpuWrote(dstBuf, gScreenWidth * gScreenHeight * 2);
 }
 
 extern FrameMatrices *gGfxCurrentFrameBuffer;
@@ -522,24 +524,26 @@ void transitionMaskFramebuffer(u16 *framebuffer) {
     s32 elapsed = gTransitionProgress - 5;
     s32 count = (elapsed * 240) / 80;
 
+    portGfxSyncRdram(framebuffer, 0x140 * 0xF0 * 2);
     for (i = 0; i < count; i++) {
-        pixels[0] = pixels[0] & mask[(i & 3) * 6];
-        pixels[1] = pixels[1] & mask[(i & 3) * 6 + 1];
-        pixels[2] = pixels[2] & mask[(i & 3) * 6 + 2];
-        pixels[3] = pixels[3] & mask[(i & 3) * 6 + 3];
-        pixels[4] = pixels[4] & mask[(i & 3) * 6 + 4];
-        pixels[5] = pixels[5] & mask[(i & 3) * 6 + 5];
+        pixels[0] = pixels[0] & PORT_BE16(mask[(i & 3) * 6]);
+        pixels[1] = pixels[1] & PORT_BE16(mask[(i & 3) * 6 + 1]);
+        pixels[2] = pixels[2] & PORT_BE16(mask[(i & 3) * 6 + 2]);
+        pixels[3] = pixels[3] & PORT_BE16(mask[(i & 3) * 6 + 3]);
+        pixels[4] = pixels[4] & PORT_BE16(mask[(i & 3) * 6 + 4]);
+        pixels[5] = pixels[5] & PORT_BE16(mask[(i & 3) * 6 + 5]);
         pixels += 320;
     }
     for (i = count; i < 240; i++) {
-        pixels[0] |= 1;
-        pixels[1] |= 1;
-        pixels[2] |= 1;
-        pixels[3] |= 1;
-        pixels[4] |= 1;
-        pixels[5] |= 1;
+        pixels[0] |= PORT_BE16(1);
+        pixels[1] |= PORT_BE16(1);
+        pixels[2] |= PORT_BE16(1);
+        pixels[3] |= PORT_BE16(1);
+        pixels[4] |= PORT_BE16(1);
+        pixels[5] |= PORT_BE16(1);
         pixels += 320;
     }
+    portGfxCpuWrote(framebuffer, 0x140 * 0xF0 * 2);
 }
 
 void transitionSetState(u8 state) {
diff --git a/src/global/15050.c b/src/global/15050.c
index f0f7f73..b416def 100644
--- a/src/global/15050.c
+++ b/src/global/15050.c
@@ -224,9 +224,10 @@ void loadOverlay(u8 keepSurvivors, u8 overlayId, s32 bufferSize) {
         pix = (u8 *)gFramebuffers[fb];
         p = (u32 *)(pix + (gHiResScale * 0x12C00 * gHiResScale) / 2 * 4); // FAKE: p (loop 2's survivor payload) reused for the framebuffer end: the inner-loop refs raise p's adjsave 30 -> 75, so p takes v1 before hp (30) and hp gets a3 (0x320-0x354); a separate end pointer ties them at 30 and hp takes v1 (9 lines)
         while (pix < (u8 *)p) {
-            *(u32 *)pix = 0x10001;
+            *(u32 *)pix = PORT_BE32(0x10001);
             pix += 4;
         }
+        portGfxCpuWrote(gFramebuffers[fb], (gHiResScale * 0x12C00 * gHiResScale) / 2 * 4);
     }
 }
 
diff --git a/src/global/2DE90.c b/src/global/2DE90.c
index aac9a04..2804464 100644
--- a/src/global/2DE90.c
+++ b/src/global/2DE90.c
@@ -318,7 +318,7 @@ void screenBlurApply(void) {
             }
             idx = sBlurKernelWidth / 2;
             for (i = 0; i < sBlurKernelWidth / 2; i++, idx++) {
-                pix = *src++;
+                pix = PORT_BE16(*src++);
                 vr = (pix >> 11) & 0x1F;
                 r[idx] = vr;
                 sumR += vr;
@@ -331,7 +331,7 @@ void screenBlurApply(void) {
             }
             idx = 0;
             for (i = 0; i < D_80747B30 - sBlurKernelWidth / 2; i++, idx++) {
-                pix = *src++;
+                pix = PORT_BE16(*src++);
                 if (idx >= sBlurKernelWidth) {
                     idx = 0;
                 }
@@ -347,7 +347,7 @@ void screenBlurApply(void) {
                 sumB -= b[idx];
                 b[idx] = vb;
                 sumB += vb;
-                *dst++ = 1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11);
+                *dst++ = PORT_BE16(1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11));
             }
             for (i = D_80747B30 - sBlurKernelWidth / 2; i < D_80747B30; i++, idx++) {
                 if (idx >= sBlurKernelWidth) {
@@ -359,7 +359,7 @@ void screenBlurApply(void) {
                 r[idx] = 0;
                 g[idx] = 0;
                 b[idx] = 0;
-                *dst++ = 1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11);
+                *dst++ = PORT_BE16(1 | (lut[sumB] << 1) | (lut[sumG] << 6) | (lut[sumR] << 11));
             }
         }
         sBlurPassCount++;
diff --git a/src/global/450.c b/src/global/450.c
index 1a1a1f6..97bcfcd 100644
--- a/src/global/450.c
+++ b/src/global/450.c
@@ -266,7 +266,7 @@ void viModeApplyHighRes(void) {
     fb = gFramebuffers[0];
     end = fb + 320 * 240;
     while (fb < end) {
-        *fb++ = 1;
+        *fb++ = PORT_BE16(1);
     }
     osWritebackDCacheAll();
 
@@ -291,9 +291,11 @@ void viModeApplyHighRes(void) {
     fb = gFramebuffers[1];
     end = fb + 320 * 240;
     while (fb < end) {
-        *fb++ = 1;
+        *fb++ = PORT_BE16(1);
     }
     osWritebackDCacheAll();
+    portGfxCpuWrote(gFramebuffers[0], 0x25800);
+    portGfxCpuWrote(gFramebuffers[1], 0x25800);
 }
 
 
