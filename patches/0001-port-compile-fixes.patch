diff --git a/include/libultra/guint.h b/include/libultra/guint.h
index c3206dd..7716ae4 100644
--- a/include/libultra/guint.h
+++ b/include/libultra/guint.h
@@ -17,13 +17,24 @@ typedef union
 {
 	struct
 	{
+#ifdef TARGET_PORT /* little-endian host: the low word of a double comes first */
+		unsigned int lo;
+		unsigned int hi;
+#else
 		unsigned int hi;
 		unsigned int lo;
+#endif
 	} word;
 
 	double	d;
 } du;
 
+#ifdef TARGET_PORT
+#define DU(hi, lo) { { (lo), (hi) } }
+#else
+#define DU(hi, lo) { { (hi), (lo) } }
+#endif
+
 typedef union
 {
 	unsigned int	i;
