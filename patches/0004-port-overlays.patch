From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:04:35 -0700
Subject: [PATCH] port: overlays


diff --git a/src/global/15050_heap.c b/src/global/15050_heap.c
index f87f433..cd7209f 100644
--- a/src/global/15050_heap.c
+++ b/src/global/15050_heap.c
@@ -218,14 +218,7 @@ void loadOverlay(u8 keepSurvivors, u8 overlayId, s32 bufferSize) {
     gRdpOutputBufferSize = (bufferSize == 0) ? 0x28000 : bufferSize;
     gRdpOutputBuffer = heapAlloc(gRdpOutputBufferSize + 0x80);
     heapLockBlock(gRdpOutputBuffer);
-    if (size != 0) {
-        if (bssStart) {
-            bzero((void *)bssStart, bssSize);
-        }
-        dmaReadAssetDecompress(romStart, (void *)vram, &size, 1, 1, 1, NULL);
-        osWritebackDCache((void *)vram, size);
-        osInvalICache((void *)vram, size);
-    }
+    portOverlayActivate(overlayId);
     for (fb = 0; fb < 2; fb++) {
         pix = (u8 *)gFramebuffers[fb];
         p = (u32 *)(pix + (gHiResScale * 0x12C00 * gHiResScale) / 2 * 4); // FAKE: p (loop 2's survivor payload) reused for the framebuffer end: the inner-loop refs raise p's adjsave 30 -> 75, so p takes v1 before hp (30) and hp gets a3 (0x320-0x354); a separate end pointer ties them at 30 and hp takes v1 (9 lines)
diff --git a/src/global/450_main_loop.c b/src/global/450_main_loop.c
index 23fd554..013d539 100644
--- a/src/global/450_main_loop.c
+++ b/src/global/450_main_loop.c
@@ -60,7 +60,6 @@
 #include "proto/global/FCCD0_slot_queue.h"
 #include "proto/global/FE40_asset_dma.h"
 
-void func_80024000(void);
 void func_80026FD0(void *);
 void func_8002EC08(s32);
 
@@ -448,10 +447,10 @@ void mainThreadLoop(void *arg) {
                 transitionRunFrame(gInitialMap, gInitialExit);
                 break;
             case 3:
-                func_80024000();
+                portOverlayEntry();
                 break;
             case 4:
-                func_80024000();
+                portOverlayEntry();
                 break;
             case 5:
                 break;
