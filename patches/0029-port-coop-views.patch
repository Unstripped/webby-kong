diff --git a/src/global/2F550.c b/src/global/2F550.c
index 96cfd97..7526c43 100644
--- a/src/global/2F550.c
+++ b/src/global/2F550.c
@@ -531,6 +531,20 @@ extern u8 gCurrentPlayerIndex;
 extern PlayerStruct *gPlayerSlots;
 
 
+// PORT: coop: the view marker of view i (port/src/gfx/gfx.c draws only the local player's view). A cutscene's
+// camera is the same in every view: everyone watches view 0.
+u8 camIsCutsceneActive(void);
+
+u32 coopViewOwner(s32 view) {
+    if (!gPortCoop) {
+        return PORT_VIEW_SHARED;
+    }
+    if (camIsCutsceneActive()) {
+        return view == 0 ? PORT_VIEW_SHARED : PORT_VIEW_NONE;
+    }
+    return view;
+}
+
 Gfx *playerViewsRender(Gfx *gfx, void *frame) {
     s32 i;
     u8 alpha;
@@ -544,6 +558,7 @@ Gfx *playerViewsRender(Gfx *gfx, void *frame) {
         gSPSetOtherMode(gfx++, G_SETOTHERMODE_H, G_MDSFT_PIPELINE, 1, G_PM_NPRIMITIVE);
     }
     for (i = 0; i < gViewportCount; i++) {
+        gPortViewMarker(gfx++, coopViewOwner(i)); // PORT: coop
         if (gPlayerSlots[i].active != 0) {
             gCurrentPlayerIndex = i;
             gfx = mapRenderPlayerView(gfx, gPlayerSlots[i].eyeX, gPlayerSlots[i].eyeY, gPlayerSlots[i].eyeZ,
@@ -564,6 +579,7 @@ Gfx *playerViewsRender(Gfx *gfx, void *frame) {
             gDPPipeSync(gfx++);
         }
     }
+    gPortViewMarker(gfx++, PORT_VIEW_SHARED); // PORT: coop
     mapFrameEnd();
     gDPPipeSync(gfx++);
     return gfx;
