     dlAppendTextureLoad(&glist, &D_8004BC20[gGfxBufferIndex]);
-    dlSetTextureScaleAndFlip(0x400, D_8004C6D4.half[1], 0, 0);
+    dlSetTextureScaleAndFlip(0x400, (s16)D_8004C6D4.word, 0, 0);
     for (i = 1; i < 0x1B; i++) {
