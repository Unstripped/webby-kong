From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Thu, 19 Nov 2026 12:00:00 -0700
Subject: [PATCH] port: arcade texture scale endianness


diff --git a/src/arcade/0.c b/src/arcade/0.c
index d52b9c8..18e8382 100644
--- a/src/arcade/0.c
+++ b/src/arcade/0.c
@@ -18,6 +18,7 @@
 extern ArcadeEntity D_8004BCD0[];
 
 extern void *D_8004C6D0;
+/* PORT: half[1] is the low half of word only on the big-endian N64; call sites read (s16)word instead */
 typedef union ArcadeTexScale {
     s32 word;
     s16 half[2];
@@ -704,7 +705,7 @@ void arcadeDrawLadder(Gfx **glistp, s32 x, s32 y, s32 height) {
     dlInitTextureDescriptor(&D_8004BBC0[gGfxBufferIndex], D_8004C6D0, 0, D_8004C719, D_8004C719, 3, 0, 2, 0, 0);
     glist = *glistp;
     dlAppendTextureLoad(&glist, &D_8004BB30[gGfxBufferIndex]);
-    dlSetTextureScaleAndFlip(0x400, D_8004C6D4.half[1], 0, 0);
+    dlSetTextureScaleAndFlip(0x400, (s16)D_8004C6D4.word, 0, 0);
     for (i = 0; i < height / 4; i++) {
         dlAppendTextureRectangle(&glist, x * 4, (s32)((f64)(i * 4 + y + 8) * 4.0));
     }
@@ -721,7 +722,7 @@ void arcadeDrawLadder(Gfx **glistp, s32 x, s32 y, s32 height) {
             dlAppendTextureLoad(&glist, &D_8004BBC0[gGfxBufferIndex]);
             break;
         }
-        dlSetTextureScaleAndFlip(0x400, D_8004C6D4.half[1], 0, 0);
+        dlSetTextureScaleAndFlip(0x400, (s16)D_8004C6D4.word, 0, 0);
         dlAppendTextureRectangle(&glist, x * 4, (s32)((f64)(i * 4 + y + 8) * 4.0));
     }
     *glistp = glist;
@@ -860,7 +861,7 @@ void arcadeDrawTitleText(Gfx **glistp) {
     else D_8004C6D0 = D_80032DF8;
     dlInitTextureDescriptor(&D_8004BB00[gGfxBufferIndex], D_8004C6D0, 0, D_8004C719, D_8004C719, D_8004C71A, 0, 2, 0, 0);
     dlAppendTextureLoad(&glist, &D_8004BB00[gGfxBufferIndex]);
-    dlSetTextureScaleAndFlip(0x400, D_8004C6D4.half[1], 0, 0);
+    dlSetTextureScaleAndFlip(0x400, (s16)D_8004C6D4.word, 0, 0);
     for (i = 0; i < 12; i++) {
         row = titleBitmap[i];
         for (j = 0; j < 25; j++) {
@@ -884,7 +885,7 @@ void arcadeDrawStage1Background(Gfx **glistp) {
