+        /* port quicksave: start a requested resume once the EEPROM is read and no transition is pending */
+        if (gPortResume.pending && gEepromLoaded == 1 && (gGameMode == 0 || gGameMode == 1) && !(gScreenRenderFlags & 1)
+            && !(gGlobalPauseFlags & 0x100)) {
+            gPortResume.pending = 0;
+            menuStartGameAtResume();
+        }
         switch (gGameMode) {
             case 6:
                 transitionRunFrame(gInitialMap, gInitialExit);
