Subject: [PATCH] port: quicksave resume


diff --git a/src/global/117190.c b/src/global/117190.c
index 3ce5ea1..f7ecbe9 100644
--- a/src/global/117190.c
+++ b/src/global/117190.c
@@ -883,6 +883,23 @@ void menuStartGameFromSave(s8 saveSlot) {
     gMenuTargetMode = 6;
 }
 
+/* port quicksave: start the save in gPortResume.slot straight at the captured map/exit/position */
+void menuStartGameAtResume(void) {
+    gPauseTimeTotal = osGetTime();
+    gMenuBonusTimer.active = 0;
+    playerResetSpawnGlobals();
+    flagsClearAllBank2();
+    eepromLoadPlayerData(gPortResume.slot, 1);
+    gPlayerCharacterId[0] = gPortResume.kong;
+    controllerSetActiveMask(1);
+    /* mapLoadSavedSlotSpawn applies x/y/z/yaw until the transition's mapRequestTransition loads the map */
+    gPortResume.spawnArmed = gPortResume.hasPos;
+    mapRequestTransitionFast(gPortResume.map, gPortResume.exit);
+    gMenuTargetMode = 6;
+    PORT_TRACE(PORT_TRACE_MAP, "resume slot=%d kong=%d map=0x%x exit=%d pos=%d", (int)gPortResume.slot,
+               (int)gPortResume.kong, (int)gPortResume.map, (int)gPortResume.exit, (int)gPortResume.hasPos);
+}
+
 
 
 void mpStartMatch(void) {
diff --git a/src/global/3C10.c b/src/global/3C10.c
index 9402f60..db3ee3d 100644
--- a/src/global/3C10.c
+++ b/src/global/3C10.c
@@ -528,6 +528,7 @@ void mapRequestTransition(s32 map, s32 exitIndex) {
             }
             flagTempsPruneUnloadedMaps();
             mapLoadSavedSlotSpawn(map);
+            gPortResume.spawnArmed = 0; /* port quicksave: the resume spawn applied to this load only */
             if (gGlobalOverlayFlags & 1) {
                 func_8002920C();
             }
@@ -567,6 +568,14 @@ void mapLoadSavedSlotSpawn(s32 map) {
         gSavedSlotSpawnY = gSavedMapSlots[idx].y;
         gSavedSlotSpawnZ = gSavedMapSlots[idx].z;
         gSavedSlotSpawnYaw = gSavedMapSlots[idx].yaw;
+    } else if (gPortResume.spawnArmed && map == gPortResume.map) {
+        /* port quicksave resume: armed by menuStartGameAtResume through mapRequestTransitionFast and the
+         * transition's mapRequestTransition */
+        gSavedSlotSpawnFlags = 1 | PORT_SPAWN_EXACT_YAW;
+        gSavedSlotSpawnX = gPortResume.x;
+        gSavedSlotSpawnY = gPortResume.y;
+        gSavedSlotSpawnZ = gPortResume.z;
+        gSavedSlotSpawnYaw = gPortResume.yaw;
     } else {
         gSavedSlotSpawnFlags = 0;
     }
@@ -628,6 +637,50 @@ s32 mapFindPreviousSavedMap(s32 *outMap, s32 *outExitIndex) {
     return found;
 }
 
+extern u8 gMenuCurrentMode;
+extern u8 gEepromCurrentSlot;
+
+/* port quicksave: where a reload should resume. Inside a sub-area (barrel minigame etc.), the parent map's
+ * return slot: the sub-area cannot be re-entered without it. */
+s32 mapCaptureResumePoint(PortResumePoint *out, const char **reason) {
+    s32 i;
+
+    if (gMenuCurrentMode != 6) {
+        *reason = "not in adventure mode";
+        return 0;
+    }
+    if (gGameMode != 0 && gGameMode != 1) {
+        *reason = "map transition in progress";
+        return 0;
+    }
+    out->slot = gEepromCurrentSlot;
+    out->kong = gPlayerCharacterId[0] < 5 ? gPlayerCharacterId[0] : 0;
+    for (i = 0; i < 18; i++) {
+        if (gSavedMapSlots[i].inUse != 0 && (gSavedMapSlots[i].flags & 2)) {
+            out->map = gSavedMapSlots[i].map;
+            out->exit = gSavedMapSlots[i].returnExitIndex;
+            out->hasPos = gSavedMapSlots[i].flags & 1;
+            out->x = gSavedMapSlots[i].x;
+            out->y = gSavedMapSlots[i].y;
+            out->z = gSavedMapSlots[i].z;
+            out->yaw = gSavedMapSlots[i].yaw;
+            return 1;
+        }
+    }
+    if (gPrimaryPlayerActor == NULL) {
+        *reason = "no player";
+        return 0;
+    }
+    out->map = gCurrentMap;
+    out->exit = gInitialExit;
+    out->hasPos = 1;
+    out->x = gPrimaryPlayerActor->x;
+    out->y = gPrimaryPlayerActor->y;
+    out->z = gPrimaryPlayerActor->z;
+    out->yaw = gPrimaryPlayerActor->yaw;
+    return 1;
+}
+
 void mapTransitionToPreviousOrExit(void) {
     s32 targetMap;
     s32 exitIndex;
diff --git a/src/global/450.c b/src/global/450.c
index 2c87c44..747bd35 100644
