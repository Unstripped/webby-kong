From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:12:08 -0700
Subject: [PATCH] port: audio endianness


diff --git a/src/global/5A50_seq_player.c b/src/global/5A50_seq_player.c
index 1670ad8..8721768 100644
--- a/src/global/5A50_seq_player.c
+++ b/src/global/5A50_seq_player.c
@@ -69,6 +69,7 @@ void audioInit(void) {
     dmaReadAssetDecompress(gSegmentTable[15].romStart, tmp, &len, 0xD, 0, 2, 0);
     bankA = alHeapDBAlloc(NULL, 0, &gAudioHeap, 1, len);
     dmaReadAssetDecompress(gSegmentTable[15].romStart, bankA, &len, 0xD, 0, 2, 0);
+    portSwapBankFile(bankA);
     alBnkfNew(bankA, (u8 *)gSegmentTable[14].romStart);
     gSfxBankHigh = bankA->bankArray[0];
     len = gSegmentTable[16].romEnd - gSegmentTable[16].romStart;
@@ -76,6 +77,7 @@ void audioInit(void) {
     heapFree(tmp);
     bankB = alHeapDBAlloc(NULL, 0, &gAudioHeap, 1, len);
     dmaReadAssetDecompress(gSegmentTable[16].romStart, bankB, &len, 0xD, 0, 2, 0);
+    portSwapBankFile(bankB);
     alBnkfNew(bankB, (u8 *)gSegmentTable[17].romStart);
     gSfxBank = bankB->bankArray[0];
     seqp.maxVoices = 0x2C;
diff --git a/src/global/7130_sfx.c b/src/global/7130_sfx.c
index 3cf97ec..cb43aed 100644
--- a/src/global/7130_sfx.c
+++ b/src/global/7130_sfx.c
@@ -2358,6 +2358,7 @@ void seqLoadAndPlay(s32 seqIndex, u8 seqId, f32 volume) {
         dmaReadAssetDecompress(addr, gSeqBuffers[seqIndex], &len, 0x80, 0, 1, buf);
     }
     heapFree(buf);
+    portSwapSeqHeader(gSeqBuffers[seqIndex]);
     n_alCSeqNew(&gSeqCSeqs[seqIndex], gSeqBuffers[seqIndex]);
     alSeqpSetSeq((ALSeqPlayer *)gSeqPlayers[seqIndex], (ALSeq *)&gSeqCSeqs[seqIndex]);
     resetCSPChannelStates(gSeqPlayers[seqIndex]);
