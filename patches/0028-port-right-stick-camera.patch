From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Mon, 23 Nov 2026 21:19:17 -0700
Subject: [PATCH] port: right stick camera


diff --git a/include/proto/global/201B0.h b/include/proto/global/201B0.h
index 24290fa..8a10bc5 100644
--- a/include/proto/global/201B0.h
+++ b/include/proto/global/201B0.h
@@ -119,6 +119,9 @@ void camUpdateFollowHeight(struct CamState *);
 #ifndef PROTO_SKIP_camUpdateFollowTargetDistance
 void camUpdateFollowTargetDistance(Actor *);
 #endif
+#ifndef PROTO_SKIP_camPortRightStick
+void camPortRightStick(CamState *, s32, s32); // PORT: right-stick camera
+#endif
 #ifndef PROTO_SKIP_camEndPath
 void camEndPath(Actor *);
 #endif
diff --git a/src/global/201B0.c b/src/global/201B0.c
index 5431d14..0c4760f 100644
--- a/src/global/201B0.c
+++ b/src/global/201B0.c
@@ -919,6 +919,26 @@ void camUpdateFollowHeight(CamState *cam) {
     }
 }
 
+// PORT: right-stick camera (web setting gPortStickCamera). Tilt of player 0's follow camera: 1 looks up from near
+// the floor, -1 looks down from above. camUpdateFollowTargetDistance eases it toward the target the stick sets each
+// player-input frame, then clears the target, so the tilt springs back once the stick is released.
+static f32 sPortCamTilt;
+static f32 sPortCamTiltTarget;
+
+// PORT: called by playerInputUpdate (E4090.c) in player states whose C-Left turns the camera, with the gamepad
+// right stick (-80..80, up positive). X turns like held C-Left/C-Right: gPortCameraSpeed 5 = the C-button turn's
+// 0x66 per frame at full tilt. Y sets the tilt target.
+void camPortRightStick(CamState *st, s32 stickX, s32 stickY) {
+    if (st->mode == 2) { // no C-button turning in mode 2 either (camUpdateFollowTargetDistance drops pendingTurn)
+        return;
+    }
+    if (stickX != 0) {
+        st->orbitYaw = (st->orbitYaw + stickX * 0x66 * gPortCameraSpeed / 400) & 0xFFF;
+        st->repositionFrames = 0xB; // as a C-button turn: quick eye blend (camUpdateFollowBlend), no occlusion nudge (camHandleOcclusion)
+    }
+    sPortCamTiltTarget = stickY / 80.0f;
+}
+
 void camUpdateFollowTargetDistance(Actor *camActor) {
     CamState *cam = camActor->customState;
     f32 target = gPlayerPadState[cam->playerIndex].stickY * 0.5;
@@ -968,6 +988,13 @@ void camUpdateFollowTargetDistance(Actor *camActor) {
         cam->pendingTurn = 0;
         cam->repositionFrames = 0;
     }
+    if (cam->playerIndex == 0) { // PORT: right-stick tilt eases toward the stick, back to 0 when released
+        sPortCamTilt += (sPortCamTiltTarget - sPortCamTilt) * 0.2f;
+        if (sPortCamTiltTarget == 0.0f && sPortCamTilt > -0.01f && sPortCamTilt < 0.01f) {
+            sPortCamTilt = 0.0f;
+        }
+        sPortCamTiltTarget = 0.0f;
+    }
 }
 
 void camEndPath(Actor *camActor) {
@@ -2314,6 +2341,9 @@ u8 camComputeFollowPos(Actor *camActor, Actor *target, f32 *outX, f32 *outY, f32
         cam->eyeRaiseFrames--;
         y += 130.0f;
     }
+    if (cam->playerIndex == 0 && sPortCamTilt != 0.0f) { // PORT: right-stick tilt raises/lowers the eye
+        y += (sPortCamTilt > 0.0f) ? -60.0f * sPortCamTilt : -200.0f * sPortCamTilt;
+    }
     x = target->x - mathSinF(cam->orbitYaw) * dist;
     z = target->z - mathCosF(cam->orbitYaw) * dist;
     if (lookAhead > 0.0f) {
@@ -2361,6 +2391,9 @@ void camComputeFocusPos(CamState *st, f32 *outX, f32 *outY, f32 *outZ) {
         *outZ = actor->z;
     }
     *outY = ((st->targetAnchorY + idx) - (st->followBaseY + idx)) * y + (st->followBaseY + idx);
+    if (st->playerIndex == 0 && sPortCamTilt > 0.0f) { // PORT: right-stick tilt looks up
+        *outY += 60.0f * sPortCamTilt;
+    }
 }
 
 void camComputeFocusPosOffset(CamState *st, f32 *outX, f32 *outY, f32 *outZ, f32 offset) {
diff --git a/src/global/E4090.c b/src/global/E4090.c
index 095d52f..7e73d19 100644
--- a/src/global/E4090.c
+++ b/src/global/E4090.c
@@ -923,6 +923,16 @@ PlayerInputHandlers gPlayerInputHandlers[107] = {
     } },
 };
 
+// PORT: right-stick camera (web setting gPortStickCamera; port/src/input.c fills gPortCameraStick*): wherever C-Left
+// turns the camera (19 of the 107 handler sets), the right stick turns and tilts it (camPortRightStick, 201B0.c)
+static void playerPortRightStickCamera(s32 handlerSet) {
+    if (gCurrentPlayerIndex != 0 || (gActivePlayerState->stateFlags2 & 0x20) ||
+        gPlayerInputHandlers[handlerSet].fn[13] != playerInputCamRotateLeft) {
+        return;
+    }
+    camPortRightStick(gActivePlayerState->camActor->customState, gPortCameraStickX, gPortCameraStickY);
+}
+
 s32 playerInputUpdate(s32 handlerSet) {
     f32 minSq;
     f32 maxSq;
@@ -1056,6 +1066,7 @@ s32 playerInputUpdate(s32 handlerSet) {
         gPlayerInputHandlers[handlerSet].fn[14]();
     }
     gPlayerInputHandlers[handlerSet].fn[16]();
+    playerPortRightStickCamera(handlerSet); // PORT
     return gActivePlayerActor->state - prevState;
 }
 
