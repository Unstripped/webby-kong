@@ -126,6 +127,19 @@ f32 renderScaleDistanceByFov(f32 dist) {
     return (dist / gDefaultFovCos) * gViewFovScaledCos;
 }
 
+extern f32 gGfxFarClip;
+
+// PORT: object draw distances and enemy spawn ranges times gPortDrawDistance, out to the map's far clip (nothing past it
+// is seen) but never shorter than the game's own. Callers apply renderScaleDistanceByFov on top, as for the original.
+f32 renderExtendDistance(f32 dist) {
+    f32 ext = dist * gPortDrawDistance;
+
+    if (ext > gGfxFarClip) {
+        ext = gGfxFarClip;
+    }
+    return ext > dist ? ext : dist;
+}
