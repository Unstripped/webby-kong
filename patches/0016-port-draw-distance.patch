+// PORT: the in-range test that lets mapChunksRender skip entries uses the extended draw distance, as the objects' own
+// culls do. Effects keep theirs: their fades (effectPlayerDistanceFadeUpdate) end at maxDistance.
+static f32 renderEntryMaxDist(RenderEntry *entry) {
+    return entry->unk24 == 5 ? entry->unk1C : renderExtendDistance(entry->unk1C);
+}
