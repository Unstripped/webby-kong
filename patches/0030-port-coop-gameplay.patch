+// PORT: coop: the player index using this tag barrel (0 with one player)
+static s32 tagBarrelCoopPlayer(TagBarrelData *data) {
+    s32 i;
+
+    if (gPortCoop) {
+        for (i = 0; i < gPlayerCount; i++) {
+            if (gPlayerSlots[i].actor == data->player) {
+                return i;
+            }
+        }
+    }
+    return 0;
+}
+
+// PORT: coop: bit k = kong k (0..4) played by a session slot, other than player index `except` on this map
+static s32 coopHeldKongs(s32 except) {
+    s32 held;
+    s32 s;
+    s32 i;
+    s32 onMap;
+    s32 k;
+
+    held = 0;
+    if (!gPortCoop) {
+        if (gPlayerCharacterId[0] < 5) {
+            held |= 1 << gPlayerCharacterId[0];
+        }
+        return held;
+    }
+    for (s = 0; s < PORT_MAX_PLAYERS; s++) {
+        if (!(gPortCoopActiveMask & (1 << s))) {
+            continue;
+        }
+        onMap = -1;
+        for (i = 0; i < gPortCoopPlayers && i < gPlayerCount; i++) {
+            if (gPortCoopPlayerSlot[i] == s) {
+                onMap = i;
+            }
+        }
+        if (onMap >= 0 && onMap == except) {
+            continue;
+        }
+        k = (onMap >= 0 && gPlayerCharacterId[onMap] < 5) ? gPlayerCharacterId[onMap] : gPortCoopSlotKong[s];
+        if (k < 5) {
+            held |= 1 << k;
+        }
+    }
+    return held;
+}
+
+// PORT: coop: kongs a joining player can take: unlocked in this save (the tag barrel test) and not played
+s32 coopFreeKongs(void) {
+    s32 i;
+    s32 unlocked;
+
+    unlocked = 0;
+    for (i = 0; i < 5; i++) {
+        if (flagGet(mapGetConfigValue(0, i), 0)) {
+            unlocked |= 1 << i;
+        }
+    }
+    return unlocked & ~coopHeldKongs(-1);
+}
 
