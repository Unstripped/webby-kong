         for (i = 0; i < gActorGlobalState.volumeTriggerQueueCount; i++) {
             if (gActorGlobalState.volumeTriggerQueueOp[i] == 3) {
                 endOnTrigger = 1;
-                triggerKind = gActorGlobalState.volumeTriggerQueueId[i][1]; // low byte of the record's second s16 (1295B0 reads the same word as the actor state)
+                triggerKind = (u8)gActorGlobalState.volumeTriggerQueueId[i][1]; // low byte of the record's second s16 (1295B0 reads the same word as the actor state)
                 switch (challengeType) {
                 case 0:
                     if (counter->countLeft != 0) {
diff --git a/src/global/12E800_behaviour.c b/src/global/12E800_behaviour.c
index 443ac14..20d9f92 100644
--- a/src/global/12E800_behaviour.c
+++ b/src/global/12E800_behaviour.c
@@ -241,8 +241,8 @@ void behaviourPickRandomTargetY(void) {
     s32 rnd;
     s32 minY;
 
-    if (gBehaviourExtraState->unkAWide != 0) {
-        maxY = gBehaviourExtraState->y + gCurrentActor->eyeHeight + gBehaviourExtraState->unkAWide;
+    if (portReadBE16(&gBehaviourExtraState->unkAWide) != 0) { /* spawn-node field kept big-endian: also read as two bytes */
+        maxY = gBehaviourExtraState->y + gCurrentActor->eyeHeight + (s16)portReadBE16(&gBehaviourExtraState->unkAWide);
     } else {
         maxY = (s16)gCurrentActor->waterY - gCurrentActor->eyeHeight;
     }
diff --git a/src/global/450_main_loop.c b/src/global/450_main_loop.c
index c05e9e3..ae78def 100644
--- a/src/global/450_main_loop.c
+++ b/src/global/450_main_loop.c
@@ -389,6 +389,9 @@ void mainResetEngineState(void) {
     osInvalDCache((void *)0x80000000, 0x800000);
     gSegment1Data = &gSegment1DataBuffer;
     dmaReadAssetDecompress(gSegmentTable[12].romStart, gSegment1Data, &gSegment1DataSize, 0, 0, 0, NULL);
+    /* segment 1: two Vp (s16) at 0x00-0x1F, then display lists */
+    portSwap16(gSegment1Data, 0x20 / 2);
+    portSwap32((u8 *)gSegment1Data + 0x20, (gSegment1DataSize - 0x20) / 4);
     gGfxSubListEnabled = FALSE;
     controllerWaitRead();
     gFrameCounter = 0;
diff --git a/src/global/6AD90_collision.c b/src/global/6AD90_collision.c
index 18d4800..86ea623 100644
--- a/src/global/6AD90_collision.c
+++ b/src/global/6AD90_collision.c
@@ -82,6 +82,7 @@ void collisionBuildCellTable(MapFileHeader *header) {
         dst = data;
         src = compressed;
         gunzip(&src, &dst, window);
+        portAssetSwap(3, gCurrentMap, data, (u32)(dst - data));
         heapFree(window);
         assetSetImmediateFree();
         assetFreeBuffer(compressed, 0x9D, 0x3A);
@@ -1054,6 +1055,7 @@ void collisionCellEnsureLoaded(s32 index) {
             sCollisionCells[index].tris = heapAlloc(size);
             sCollisionCells[index].trisEnd = sCollisionCells[index].tris + size / sizeof(CollisionStaticTri);
             dmaReadAssetDecompress(sCollisionCells[index].romAddr, sCollisionCells[index].tris, &size, 0, 0, 0, 0);
+            portSwapCollisionTris(sCollisionCells[index].tris, size);
         }
     }
     sCollisionCells[index].lastUsedFrame = gFrameCounter;
@@ -2005,6 +2007,7 @@ void dmaDrainQueueAndFreeBuffer(void) {
         if (sDmaQueue[i].compressed != 0) {
             assetInflateAndFree(sDmaQueue[i].dmaDst, sDmaQueue[i].buffer);
         }
+        portAssetDrained(i);
     }
     if (sInflateWindow != NULL) {
         heapFree(sInflateWindow);
@@ -2095,6 +2098,7 @@ void *assetLoad(s32 table, s32 index, u8 sync, u8 noCache) { // index: asset ind
         } else {
             dmaReadAssetDecompress(romAddr, buffer, &size, 0, 0, 0, 0);
         }
+        portAssetSwap(table, index, buffer, allocSize);
     } else {
         if (sDmaQueueCount == 0xC0) {
             faultSetMessage(6, 0, 0, 0);
@@ -2109,6 +2113,7 @@ void *assetLoad(s32 table, s32 index, u8 sync, u8 noCache) { // index: asset ind
         }
         osInvalDCache(sDmaQueue[sDmaQueueCount].dmaDst, size);
         osPiStartDma(&sDmaIoMesgs[sDmaQueueCount], 0, 0, romAddr, sDmaQueue[sDmaQueueCount].dmaDst, size, &gAssetDmaDoneQueue);
+        portAssetQueued(sDmaQueueCount, table, index, buffer, allocSize);
         sDmaQueueCount += 1;
     }
     assetSetTableEntry(table, index, buffer);
diff --git a/src/global/70FD0_collision_geometry.c b/src/global/70FD0_collision_geometry.c
