diff --git a/src/global/BC3B0_cursor_emitters.c b/src/global/BC3B0_cursor_emitters.c
index c1ce3e8..9ca4f07 100644
--- a/src/global/BC3B0_cursor_emitters.c
+++ b/src/global/BC3B0_cursor_emitters.c
@@ -135,10 +135,10 @@ void actorUpdateLockOnCursor(void) {
     if (!(gCurrentActor->flags & 0x10)) {
         gBehaviourAnimState->flags |= 0x60;
         gGlobalOverlayFlags |= 2;
-        hudSpawnCountdownTimer(0xDC, 0x2A, gBehaviourExtraState->unkAWide ? gBehaviourExtraState->unkAWide : 10);
-        gBehaviourWorkState->countdown = gBehaviourExtraState->unkAWide != 0 ? 0xF : 0x78;
-        if (gBehaviourExtraState->unkAWide != 0) {
-            c->beepInterval = gBehaviourExtraState->unkAWide;
+        hudSpawnCountdownTimer(0xDC, 0x2A, portReadBE16(&gBehaviourExtraState->unkAWide) ? (s16)portReadBE16(&gBehaviourExtraState->unkAWide) : 10);
