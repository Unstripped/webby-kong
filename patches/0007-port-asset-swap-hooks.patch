         } else {
             c->beepInterval = 10.0f;
         }
@@ -194,8 +194,8 @@ void actorUpdateLockOnCursor(void) {
         } else {
             actorCursorFireProjectile(c);
             gBehaviourWorkState->countdown = 0x64;
-            if (gBehaviourExtraState->unkAWide != 0) {
-                c->beepInterval = gBehaviourExtraState->unkAWide;
+            if (portReadBE16(&gBehaviourExtraState->unkAWide) != 0) {
+                c->beepInterval = (s16)portReadBE16(&gBehaviourExtraState->unkAWide);
             } else {
                 c->beepInterval = 10.0f;
             }
