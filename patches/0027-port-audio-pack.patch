     GeSndpConfig sndp;
     ALBankFile *bankB;
@@ -86,6 +143,8 @@ void audioInit(void) {
     portSwapBankFile(bankB);
     alBnkfNew(bankB, (u8 *)gSegmentTable[17].romStart);
     gSfxBank = bankB->bankArray[0];
+    audioPortApplyPack((ALBank *)gSfxBank, 0);         // PORT: audio pack
+    audioPortApplyPack((ALBank *)gSfxBankHigh, 0x7FF); // PORT: audio pack
     seqp.maxVoices = 0x2C;
     seqp.maxEvents = 0x40;
     seqp.debugFlags = 0;
