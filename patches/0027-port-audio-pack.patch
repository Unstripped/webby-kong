+// PORT: audio pack: a replaced sound is a copy of the bank's ALSound whose RAW16 wave lives in the page's PCM
+// pool (ROM-space offsets >= PORT_PACK_PCM_BASE, port/src/ultra/pi.c); envelope, key map and pan stay the game's
+typedef struct {
+    ALSound sound;
+    ALWaveTable wave;
+    ALRawLoop loop;
+} PortPackSound;
+typedef char portPackSoundFits[sizeof(PortPackSound) <= PORT_PACK_SFX_SLOT ? 1 : -1];
+
+static void audioPortApplyPack(ALBank *bank, s32 idBase) {
+    ALInstrument *inst;
+    ALSound *orig;
+    ALKeyMap *km;
+    PortPackSound *p;
+    f32 ratio;
+    u32 origLoop;
+    u32 out[5];
+    s32 i, id, k;
+
+    portPackRegisterBank(bank, idBase);
+    inst = bank->instArray[0];
+    for (i = 0; i < portPackSfxCount(); i++) {
+        id = portPackSfxId(i);
+        k = id - idBase - 1;
+        if (k < 0 || k >= inst->soundCount || (idBase == 0 && id >= 0x800)) {
+            continue;
+        }
+        orig = inst->soundArray[k];
+        km = orig->keyMap;
+        // the sound player's pitch for this sound (__n_allocState): bake at the rate it will consume samples
+        ratio = alCents2Ratio(km->keyBase * 100 + ((km->keyMax & 0x20) ? 0 : km->detune) - 6000);
+        origLoop = 0;
+        if (orig->wavetable->type == AL_ADPCM_WAVE && orig->wavetable->waveInfo.adpcmWave.loop != NULL) {
+            origLoop = orig->wavetable->waveInfo.adpcmWave.loop->count;
+        }
+        if (!portPackSfxBake(i, 22050.0f * ratio, origLoop, out)) {
+            continue;
+        }
+        p = portPackSfxSlot();
+        if (p == NULL) {
+            break;
+        }
+        p->sound = *orig;
+        p->wave.base = (u8 *)(PORT_PACK_PCM_BASE + out[0]);
+        p->wave.len = out[1];
+        p->wave.type = AL_RAW16_WAVE;
+        p->wave.flags = 1;
+        p->loop.start = out[2];
+        p->loop.end = out[3];
+        p->loop.count = out[4];
+        p->wave.waveInfo.rawWave.loop = out[4] ? &p->loop : NULL;
+        p->sound.wavetable = &p->wave;
+        inst->soundArray[k] = &p->sound;
+    }
+}
+
