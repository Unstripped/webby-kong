diff --git a/src/global/144E00_n_load.c b/src/global/144E00_n_load.c
index 782e9b0..922214c 100644
--- a/src/global/144E00_n_load.c
+++ b/src/global/144E00_n_load.c
@@ -2,6 +2,85 @@
 #include "audio_synth.h"
 #include "proto/global/144E00_n_load.h"
 
+// PORT: audio pack: a pack's replaced sounds are RAW16 waves (5A50_seq_player.c audioPortApplyPack), which the
+// game's loader cannot pull. This follows libultra's alRaw16Pull with the three commands the game's ucode has:
+// LOADBUFF (0x04), DMEMMOVE (0x0A) and CLEARBUFF (0x02).
+static Acmd *rawLoad(Acmd *cmd, s32 dmem, s32 dram, s32 nbytes) {
+    cmd->words.w0 = 0x04000000 | ((nbytes & 0xFFF) << 12) | (dmem & 0xFFF);
+    cmd->words.w1 = dram;
+    return cmd + 1;
+}
+
+static Acmd *n_alRaw16Pull(N_PVoice *f, s16 *outp, s32 count, Acmd *cmd) {
+    s32 base = (s32)f->dc_table->base;
+    s32 nSam, nbytes, over, dramLoc, dramAlign, dmemAlign, op;
+
+    f->dc_first = 0;
+    *outp += 0x20; // the resampler's history sits before the samples, as after an ADPCM decode
+    if (f->dc_sample + count > f->dc_loop.end && f->dc_loop.count) {
+        nSam = f->dc_loop.end - f->dc_sample;
+        if (nSam < 0) {
+            nSam = 0;
+        }
+        dramAlign = 0;
+        if (nSam > 0) {
+            dramLoc = f->dc_dma(f->dc_memin, nSam * 2, f->dc_dmaState);
+            dramAlign = dramLoc & 7;
+            cmd = rawLoad(cmd, *outp, dramLoc - dramAlign, nSam * 2 + dramAlign);
+        }
+        *outp += dramAlign;
+        f->dc_memin = base + f->dc_loop.start * 2;
+        f->dc_sample = f->dc_loop.start;
+        op = *outp;
+        while (count > nSam) {
+            op += nSam * 2;
+            count -= nSam;
+            if (f->dc_loop.count != -1 && f->dc_loop.count != 0) {
+                f->dc_loop.count--;
+            }
+            nSam = f->dc_loop.end - f->dc_loop.start;
+            if (count < nSam) {
+                nSam = count;
+            }
+            dramLoc = f->dc_dma(f->dc_memin, nSam * 2, f->dc_dmaState);
+            dramAlign = dramLoc & 7;
+            dmemAlign = (op & 7) ? 8 - (op & 7) : 0;
+            op += dmemAlign; // LOADBUFF writes 8-aligned DMEM: load past the samples so far, then move back
+            cmd = rawLoad(cmd, op, dramLoc - dramAlign, nSam * 2 + dramAlign);
+            if (dramAlign || dmemAlign) {
+                cmd->words.w0 = 0x0A000000 | ((op + dramAlign) & 0xFFFF);
+                cmd->words.w1 = (((op - dmemAlign) & 0xFFFF) << 16) | ((nSam * 2) & 0xFFFF);
+                cmd++;
+            }
+            op -= dmemAlign;
+        }
+        f->dc_sample += count;
+        f->dc_memin += count * 2;
+        return cmd;
+    }
+    nbytes = count * 2;
+    over = f->dc_memin + nbytes - (base + f->dc_table->len);
+    if (over < 0) {
+        over = 0;
+    } else if (over > nbytes) {
+        over = nbytes;
+    }
+    if (over < nbytes) {
+        dramLoc = f->dc_dma(f->dc_memin, nbytes - over, f->dc_dmaState);
+        dramAlign = dramLoc & 7;
+        cmd = rawLoad(cmd, *outp, dramLoc - dramAlign, nbytes - over + dramAlign);
+        *outp += dramAlign;
+    }
+    f->dc_sample += count;
+    f->dc_memin += nbytes;
+    if (over) { // past the end of the wave: silence
+        cmd->words.w0 = 0x02000000 | ((*outp + nbytes - over) & 0xFFFF);
+        cmd->words.w1 = over;
+        cmd++;
+    }
+    return cmd;
+}
+
 Acmd *n_alAdpcmPull(N_PVoice *filter, s16 *outp, s32 count, Acmd *cmdList) {
     Acmd *cmd;
     s16 state;
@@ -29,6 +108,9 @@ Acmd *n_alAdpcmPull(N_PVoice *filter, s16 *outp, s32 count, Acmd *cmdList) {
     if (count == 0) {
         return cmd;
     }
+    if (f->dc_table->type == AL_RAW16_WAVE) { // PORT: audio pack
+        return n_alRaw16Pull(f, outp, count, cmd);
+    }
     state = 0;
     initCmd = cmd++;
     initCmd->words.w0 = (f->dc_bookSize & 0xFFFFFF) | 0x0B000000;
