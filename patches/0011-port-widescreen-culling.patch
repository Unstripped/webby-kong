From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Wed, 18 Nov 2026 07:48:09 -0700
Subject: [PATCH] port: widescreen culling


diff --git a/src/global/2F550.c b/src/global/2F550.c
index a2853ed..40b9359 100644
--- a/src/global/2F550.c
+++ b/src/global/2F550.c
@@ -85,7 +85,7 @@ void frustumCalculateCornerRays(f32 fovY, f32 aspect, f32 depth) {
     s32 i;
 
     halfPitch = fovY * 0.5;
-    halfYaw = halfPitch * aspect;
+    halfYaw = portGfxWideHalfYaw(halfPitch * aspect);
     guRotateF(pitchMtx, halfPitch, 1.0f, 0.0f, 0.0f);
     guMtxXFMF(pitchMtx, 0.0f, 0.0f, (-depth), &dirX, &dirY, &dirZ);
     guRotateF(yawMtx, halfYaw, 0.0f, 1.0f, 0.0f);
