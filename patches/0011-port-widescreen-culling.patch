Subject: [PATCH] port: widescreen culling


diff --git a/src/global/2F550.c b/src/global/2F550.c
index a0805db..96cfd97 100644
--- a/src/global/2F550.c
+++ b/src/global/2F550.c
@@ -103,7 +103,7 @@ struct MapBspNode *D_807F5DE4;
 s32 D_807F5DE8;
 void *D_807F5DEC;
 f32 sFrustumCornerRays[12];
-
+f32 mapWideFactor(void); // PORT: 55B20.c, the viewport rect widened to the displayed wide image
 
 void frustumCalculateCornerRays(f32 fovY, f32 aspect, f32 depth) {
     f32 scale;
@@ -117,7 +117,7 @@ void frustumCalculateCornerRays(f32 fovY, f32 aspect, f32 depth) {
     s32 i;
 
     halfPitch = fovY * 0.5;
-    halfYaw = halfPitch * aspect;
+    halfYaw = portGfxWideHalfYaw(halfPitch * aspect, mapWideFactor());
     guRotateF(pitchMtx, halfPitch, 1.0f, 0.0f, 0.0f);
     guMtxXFMF(pitchMtx, 0.0f, 0.0f, (-depth), &dirX, &dirY, &dirZ);
     guRotateF(yawMtx, halfYaw, 0.0f, 1.0f, 0.0f);
