@@ -1009,3 +1011,65 @@ u8 func_80600454(s16 id, u8 *outVal) {
     }
     return isNew;
 }
+
+// PORT: coop: which player started a map transition (the solo player of a minigame/boss/bonus map): the player
+// whose actor is updating, else the player nearest to it.
+extern Actor *gCurrentActor;
+extern PlayerStruct *gPlayerSlots;
+
+void coopNoteTransitionTrigger(void) {
+    s32 i;
+    s32 best;
+    f32 bestDist;
+    f32 dx;
+    f32 dy;
+    f32 dz;
+    f32 d;
+    Actor *a;
+
+    if (!gPortCoop) {
+        return;
+    }
+    best = 0;
+    bestDist = -1.0f;
+    for (i = 0; i < gPlayerCount && gPlayerSlots != NULL && gCurrentActor != NULL; i++) {
+        a = gPlayerSlots[i].actor;
+        if (a == NULL) {
+            continue;
+        }
+        if (a == gCurrentActor) {
+            best = i;
+            break;
+        }
+        dx = a->x - gCurrentActor->x;
+        dy = a->y - gCurrentActor->y;
+        dz = a->z - gCurrentActor->z;
+        d = dx * dx + dy * dy + dz * dz;
+        if (bestDist < 0.0f || d < bestDist) {
+            bestDist = d;
+            best = i;
+        }
+    }
+    gPortCoopTrigger = best;
+}
+
+// PORT: coop: the roster changed (a player joined or left): reload the map where player 1 stands, as a quicksave
+// resume does. Not possible right now (cutscene, sub-area entry...): stays dirty and is retried next frame.
+void coopReloadAtLeader(void) {
+    PortResumePoint p;
+    const char *why;
+
+    if (!mapCaptureResumePoint(&p, &why)) {
+        return;
+    }
+    gPortResume.map = p.map;
+    gPortResume.exit = p.exit;
+    gPortResume.hasPos = p.hasPos;
+    gPortResume.x = p.x;
+    gPortResume.y = p.y;
+    gPortResume.z = p.z;
+    gPortResume.yaw = p.yaw;
+    gPortResume.spawnArmed = p.hasPos;
+    mapRequestTransition(p.map, p.exit);
+    gPortCoopTrigger = 0; // coopPrepareMapLoad clears gPortCoopRosterDirty once the map loads
+}
