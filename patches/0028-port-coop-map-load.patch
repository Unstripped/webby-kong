+
+// PORT: coop: the roster of the map about to load (src/global/450.c mapLoadLevel, after viModeSetup sets the overlay
+// flags). Minigame/boss/bonus/minecart/race/menu maps are played by the player that started the transition alone.
+extern u8 gGameMode;
+
+void coopPrepareMapLoad(void) {
+    s32 i;
+    s32 n;
+    u8 slot;
+    u8 trig;
+
+    trig = gPortCoopTrigger < gPortCoopPlayers ? gPortCoopPlayerSlot[gPortCoopTrigger] : 0;
+    for (i = 0; i < gPortCoopPlayers && i < gPlayerCount; i++) {
+        slot = gPortCoopPlayerSlot[i];
+        if (gPlayerCharacterId[i] < 5 && slot < PORT_MAX_PLAYERS && (gPortCoopActiveMask & (1 << slot))) {
+            gPortCoopSlotKong[slot] = gPlayerCharacterId[i]; // kong swaps (tag barrels) persist
+        }
+    }
+    if (!(gPortCoopActiveMask & (1 << trig))) {
+        trig = 0;
+    }
+    if (gGameMode == 3 || gGameMode == 4 || (gGlobalOverlayFlags & (0x1 | 0x104000 | 0x80000 | 0x2000 | 0x40000000))) {
+        gPortCoopPlayers = 1;
+        gPortCoopPlayerSlot[0] = trig;
+    } else {
+        n = 0;
+        for (i = 0; i < PORT_MAX_PLAYERS; i++) {
+            if (gPortCoopActiveMask & (1 << i)) {
+                gPortCoopPlayerSlot[n++] = i;
+            }
+        }
+        gPortCoopPlayers = n;
+    }
+    gActivePlayerCount = gPortCoopPlayers;
+    for (i = 0; i < gPortCoopPlayers; i++) {
+        gPlayerCharacterId[i] = gPortCoopSlotKong[gPortCoopPlayerSlot[i]];
+    }
+    gSplitScreenMode = 0;
+    gPortCoopTrigger = 0;
+    gPortCoopRosterDirty = 0;
+    if (gPortCoopEnding) {
+        gPortCoop = 0;
+        gPortCoopEnding = 0;
+        gPortCoopActiveMask = 0;
+    }
+}
+
+// PORT: coop: lockstep check value (port/src/net.c): diverging clients differ here first
+extern u32 sRandomSeed;
+
+static u32 coopHashWord(u32 h, u32 v) {
+    s32 i;
+
+    for (i = 0; i < 4; i++) {
+        h = (h ^ (v & 0xFF)) * 16777619u;
+        v >>= 8;
+    }
+    return h;
+}
+
+u32 coopStateHash(void) {
+    u32 h = 2166136261u;
+    s32 i;
+    Actor *a;
+
+    h = coopHashWord(h, sRandomSeed);
+    h = coopHashWord(h, gFrameCounter);
+    h = coopHashWord(h, gCurrentMap);
+    h = coopHashWord(h, gPlayerCount);
+    for (i = 0; i < gPlayerCount && gPlayerSlots != NULL; i++) {
+        a = gPlayerSlots[i].actor;
+        if (a != NULL) {
+            h = coopHashWord(h, *(u32 *)&a->x);
+            h = coopHashWord(h, *(u32 *)&a->y);
+            h = coopHashWord(h, *(u32 *)&a->z);
+            h = coopHashWord(h, (u16)a->yaw);
+        }
+        h = coopHashWord(h, gPlayerCharacterId[i]);
+    }
+    h = coopHashWord(h, gPlayerInventoryTable[0].health);
+    return h;
+}
