Subject: [PATCH] port: level progress


diff --git a/src/global/3C10.c b/src/global/3C10.c
index abf2aab..24f34a6 100644
--- a/src/global/3C10.c
+++ b/src/global/3C10.c
@@ -644,6 +644,8 @@ s32 mapFindPreviousSavedMap(s32 *outMap, s32 *outExitIndex) {
 
 extern u8 gMenuCurrentMode;
 extern u8 gEepromCurrentSlot;
+extern u8 gPlayerCount;
+extern s16 sPauseCrownFlags[10]; /* ACDC0.c */
 
 /* port quicksave: where a reload should resume. Inside a sub-area (barrel minigame etc.), the parent map's
  * return slot: the sub-area cannot be re-entered without it. */
@@ -686,6 +688,71 @@ s32 mapCaptureResumePoint(PortResumePoint *out, const char **reason) {
     return 1;
 }
 
+/* PORT: current level's collectables for the web menu (port/src/progress.c). Attribution mirrors the pause
+ * menu (ACDC0.c hudPauseMenu): lobbies count as Isles, bonus rooms as their parent level. */
+s32 mapCaptureLevelProgress(PortLevelProgress *out, const char **reason) {
+    s32 w;
+    s32 k;
+    s32 i;
+    s32 row;
+    KongInventory *inv;
+
+    if (gMenuCurrentMode != 6) {
+        *reason = "not in adventure mode";
+        return 0;
+    }
+    /* flagGet(.., 0) in multiplayer goes through eepromGetSectionBuffer, which clears save state */
+    if (gPlayerCount >= 2 || menuIsTransitionType3Or4()) {
+        *reason = "multiplayer";
+        return 0;
+    }
+    if (gCurrentMap < 0 || gCurrentMap >= 224) {
+        *reason = "not in a level";
+        return 0;
+    }
+    w = mapGetHubWorldIndex((u8)gCurrentMap, 1);
+    if (w > 8) {
+        *reason = "not in a level";
+        return 0;
+    }
+    out->world = w;
+    out->kong = gPlayerCharacterId[0] < 5 ? gPlayerCharacterId[0] : -1;
+    row = w == 8 ? 7 : w; /* medal grid row 7 is Helm, blueprint grid row 7 is Isles */
+    for (k = 0; k < 5; k++) {
+        inv = &gPlayerInventoryTable[0].kong[k];
+        out->kongs[k].goldenBananas = w <= 7 ? inv->goldenBananas[w] : -1;
+        out->kongs[k].bananas = w <= 6 ? inv->coloredBananas[w] + inv->bananasDelivered[w] : -1;
+        out->kongs[k].medal = w != 7 ? flagGet(0x225 + row * 5 + k, 0) : -1;
+        if (w <= 7) {
+            out->kongs[k].blueprint = flagGet(0x1FD + w * 5 + k, 0) ? 2 : flagGet(0x1D5 + w * 5 + k, 0);
+        } else {
+            out->kongs[k].blueprint = -1;
+        }
+    }
+    out->fairies = 0;
+    out->fairiesTotal = 0;
+    for (i = 0; D_80755DA8[i].map != 0xFF; i++) {
+        if (D_80755DA8[i].flag >= 0x24D && D_80755DA8[i].flag <= 0x260 &&
+            mapGetHubWorldIndex(D_80755DA8[i].map, 1) == w) {
+            out->fairiesTotal++;
+            out->fairies += flagGet(D_80755DA8[i].flag, 0);
+        }
+    }
+    out->crownsTotal = w == 7 ? 2 : 1;
+    out->crowns = flagGet(sPauseCrownFlags[w], 0);
+    if (w == 7) {
+        out->crowns += flagGet(sPauseCrownFlags[9], 0);
+    }
+    if (w == 7) {
+        out->keysTotal = 0;
+        out->keys = 0;
+    } else {
+        out->keysTotal = 1;
+        out->keys = flagGet(D_80744710[w == 8 ? 7 : w], 0);
+    }
+    return 1;
+}
+
 void mapTransitionToPreviousOrExit(void) {
     s32 targetMap;
     s32 exitIndex;
