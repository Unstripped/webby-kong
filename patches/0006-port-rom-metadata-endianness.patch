Subject: [PATCH] port: rom metadata endianness


diff --git a/src/global/450.c b/src/global/450.c
index 7367e7a..624cb3a 100644
--- a/src/global/450.c
+++ b/src/global/450.c
@@ -263,8 +263,8 @@ void viModeApplyHighRes(void) {
 
     compressedBuf = (s32 *)(gFramebuffers[1] + 0x6400);
     seg11DmaRead(0x38, 0x10, compressedBuf);
-    seg11DmaRead(compressedBuf[0] + 0x178, 0x10, compressedBuf);
-    seg11DmaRead(compressedBuf[0], compressedBuf[1] - compressedBuf[0], compressedBuf);
+    seg11DmaRead(portReadBE32(&compressedBuf[0]) + 0x178, 0x10, compressedBuf);
+    seg11DmaRead(portReadBE32(&compressedBuf[0]), portReadBE32(&compressedBuf[1]) - portReadBE32(&compressedBuf[0]), compressedBuf);
 
     gzipSrc = (u8 *)compressedBuf;
     gzipDst = (u8 *)gFramebuffers[1];
diff --git a/src/global/5A50.c b/src/global/5A50.c
index 3399559..a11b4f7 100644
--- a/src/global/5A50.c
+++ b/src/global/5A50.c
@@ -115,9 +115,11 @@ void audioLoadSeqRomOffsets(void) {
 
     size1 = 0x80;
     dmaReadAssetDecompress(gSegmentTable[11].romStart, sSeqRomOffsets, &size1, 0, 0, 0, 0);
+    portSwap32(sSeqRomOffsets, 0x80 / 4);
     offset = sSeqRomOffsets[0];
     size2 = 0x2C0;
     dmaReadAssetDecompress(gSegmentTable[11].romStart + offset, sSeqRomOffsets, &size2, 0, 0, 0, 0);
+    portSwap32(sSeqRomOffsets, 0x2C0 / 4);
 }
 
