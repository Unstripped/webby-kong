From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:10:32 -0700
Subject: [PATCH] port: rom metadata endianness


diff --git a/src/global/450.c b/src/global/450.c
index 37fb7fc..20156a2 100644
--- a/src/global/450.c
+++ b/src/global/450.c
@@ -275,8 +275,8 @@ void viModeApplyHighRes(void) {
 
     compressedBuf = (u8 *)gFramebuffers[1] + 0xC800;
     seg11DmaRead(0x38, 0x10, compressedBuf);
-    seg11DmaRead(*(s32 *)compressedBuf + 0x178, 0x10, compressedBuf);
-    seg11DmaRead(*(s32 *)compressedBuf, *(s32 *)(compressedBuf + 4) - *(s32 *)compressedBuf, compressedBuf);
+    seg11DmaRead(portReadBE32(compressedBuf) + 0x178, 0x10, compressedBuf);
+    seg11DmaRead(portReadBE32(compressedBuf), portReadBE32(compressedBuf + 4) - portReadBE32(compressedBuf), compressedBuf);
 
     gzipSrc = compressedBuf;
     gzipDst = (u8 *)gFramebuffers[1];
diff --git a/src/global/5A50.c b/src/global/5A50.c
index cfcd5d7..ae2f09c 100644
--- a/src/global/5A50.c
+++ b/src/global/5A50.c
@@ -118,9 +118,11 @@ void func_806010A0(void) {
 
     size1 = 0x80;
     dmaReadAssetDecompress(D_8000DDCC, &sSeqRomOffsets, &size1, 0, 0, 0, 0);
+    portSwap32(&sSeqRomOffsets, 0x80 / 4);
     offset = sSeqRomOffsets;
     size2 = 0x2C0;
     dmaReadAssetDecompress(D_8000DDCC + offset, &sSeqRomOffsets, &size2, 0, 0, 0, 0);
+    portSwap32(&sSeqRomOffsets, 0x2C0 / 4);
 }
 
 void seqPlayerPlay(u8 playerIndex) {
