From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:05:01 -0700
Subject: [PATCH] port: thread spins


diff --git a/src/global/0.c b/src/global/0.c
index 63d7776..3278fbc 100644
--- a/src/global/0.c
+++ b/src/global/0.c
@@ -119,6 +119,7 @@ void mainThreadHalt(OSMesgQueue *queue, s32 haltCode) {
         audioThreadStop(1);
         gMainThreadHalted = 1;
         while (1) {
+            portIdleWait();
         }
     }
     osRecvMesg(queue, &receivedMsg, 1);
@@ -128,11 +129,13 @@ void mainThreadHalt(OSMesgQueue *queue, s32 haltCode) {
     osSetThreadPri(NULL, 0xB);
     sHaltStartTime = osGetTime();
     while (osGetTime() < sHaltStartTime + 0x22ADD7) {
+        portIdleWait();
     }
     osViBlack(1);
     __osSpSetStatus(0xAAAA82);
     osDpSetStatus(0x1D6);
     rumbleShutdown();
     while (1) {
+        portIdleWait();
     }
 }
diff --git a/src/global/450.c b/src/global/450.c
index 1bdcb64..5a76a30 100644
--- a/src/global/450.c
+++ b/src/global/450.c
@@ -432,6 +432,7 @@ void mainThreadLoop(void *arg) {
     while (1) {
         gMainLoopWatchdog = 0xC8;
         while (gMainThreadHalted != 0) {
+            portIdleWait();
         }
         if ((gScreenRenderFlags & 1) && gMapLoadCountdown == 0) {
             mapLoadLevel();
diff --git a/src/global/5230.c b/src/global/5230.c
index e190f3c..04b7e8d 100644
--- a/src/global/5230.c
+++ b/src/global/5230.c
@@ -118,6 +118,7 @@ void frameTimingUpdate(void) {
             p = &gScheduler.retraceCount;
             limit = sFrameTimingLastRetrace + gFrameDelta;
             while (*p < limit) {
+                portIdleWait();
             }
         }
         sFrameTimingLastRetrace = SCHED_RETRACE_COUNT;
