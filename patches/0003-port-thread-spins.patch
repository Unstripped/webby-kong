From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Tue, 17 Nov 2026 23:05:01 -0700
Subject: [PATCH] port: thread spins


diff --git a/src/global/0_init.c b/src/global/0_init.c
index 482b281..4688502 100644
--- a/src/global/0_init.c
+++ b/src/global/0_init.c
@@ -120,7 +120,9 @@ void mainThreadHalt(OSMesgQueue *queue, s32 haltReason) {
         osViBlack(TRUE);
         audioThreadStop(1);
         gMainThreadHalted = TRUE;
-        while (TRUE) {}
+        while (TRUE) {
+            portIdleWait();
+        }
     }
     osRecvMesg(queue, &msg, OS_MESG_BLOCK);
     gMainThreadHalted = TRUE;
@@ -128,10 +130,14 @@ void mainThreadHalt(OSMesgQueue *queue, s32 haltReason) {
     osStopThread(&gMainThread);
     osSetThreadPri(NULL, 11);
     sHaltStartTime = osGetTime();
-    while (osGetTime() < sHaltStartTime + 0x22ADD7) {}
+    while (osGetTime() < sHaltStartTime + 0x22ADD7) {
+        portIdleWait();
+    }
     osViBlack(TRUE);
     __osSpSetStatus(0xAAAA82);
     osDpSetStatus(0x1D6);
     rumbleShutdown();
-    while (TRUE) {}
+    while (TRUE) {
+        portIdleWait();
+    }
 }
diff --git a/src/global/450_main_loop.c b/src/global/450_main_loop.c
index fc32cc2..23fd554 100644
--- a/src/global/450_main_loop.c
+++ b/src/global/450_main_loop.c
@@ -434,6 +434,7 @@ void mainThreadLoop(void *arg) {
     while (1) {
         gMainLoopWatchdog = 0xC8;
         while (gMainThreadHalted != 0) {
+            portIdleWait();
         }
         if ((gScreenRenderFlags & 1) && gMapLoadCountdown == 0) {
             mapLoadLevel();
diff --git a/src/global/5230_frame_timing.c b/src/global/5230_frame_timing.c
index 9728d97..331dcfe 100644
--- a/src/global/5230_frame_timing.c
+++ b/src/global/5230_frame_timing.c
@@ -118,6 +118,7 @@ void frameTimingUpdate(void) {
             p = &gScheduler.retraceCount;
             limit = sFrameTimingLastRetrace + gFrameDelta;
             while (*p < limit) {
+                portIdleWait();
             }
         }
         sFrameTimingLastRetrace = SCHED_RETRACE_COUNT;
