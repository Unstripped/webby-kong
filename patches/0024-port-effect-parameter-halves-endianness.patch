From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Quinlan <mjquinlan2000@gmail.com>
Date: Fri, 20 Nov 2026 17:06:53 -0700
Subject: [PATCH] port: effect parameter halves endianness


diff --git a/include/render.h b/include/render.h
index 7503414..4696456 100644
--- a/include/render.h
+++ b/include/render.h
@@ -146,10 +146,13 @@ typedef struct EffectGridNode {
     /* 0x24 */ struct EffectGridNode *next;
 } EffectGridNode;
 
-// EffectNode.speed read as two halves by the confetti and drift effects (11BC10.c).
+// EffectNode.speed read as two halves by the confetti and drift effects (11BC10.c) and the golden banana tally's kong
+// heads (FCCD0.c).
+// PORT: declared low half first so `lo` stays the s32's low half on little-endian wasm (the N64 has it at +2). Read
+// at +2 it was the high half: every kong head in the tally took index 0 and drew over DK's.
 typedef struct EffectParamPair {
-    /* 0x0 */ s16 hi; // confetti: base angle
-    /* 0x2 */ s16 lo; // confetti: drift radius; drift effects: heading
+    s16 lo; // confetti: drift radius; drift effects: heading; tally: kong index
+    s16 hi; // confetti: base angle
 } EffectParamPair;
 
 // One live 2D/3D effect (effectCreate, 119370.c); 0x3A0 bytes.
